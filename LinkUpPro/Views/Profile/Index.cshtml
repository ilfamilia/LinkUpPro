@model EditUserViewModel

@{
    ViewData["Title"] = "Mi perfil";

    string profileImagePath = string.IsNullOrWhiteSpace(Model.ProfileImagePath)
        ? Url.Content("~/Images/Defaults/default-profile.png")
        : Url.Content($"~/{Model.ProfileImagePath}");
}

@section Styles {
    <link rel="stylesheet" href="~/css/Profile/Index.css" asp-append-version="true" />
}

<div class="profile-page my-4">
    <header class="profile-page__intro mb-4">
        <h1 class="mb-1">Mi perfil</h1>
        <p class="text-muted mb-0">Consulta tu información y mantén tus datos personales actualizados.</p>
    </header>

    <form asp-controller="Profile" asp-action="Edit" method="post"
          enctype="multipart/form-data" asp-antiforgery="true">

        <div asp-validation-summary="ModelOnly"
             class="profile-validation-summary text-danger mb-4" role="alert"></div>

        <section class="card profile-identity mb-4" aria-labelledby="profile-identity-title">
            <div class="card-body">
                <div class="d-flex align-items-center flex-wrap gap-3 gap-md-4">
                    <img src="@profileImagePath" alt="Foto de perfil actual"
                         class="profile-avatar rounded-circle" width="112" height="112" />
                    <div class="profile-identity__details">
                        <h2 id="profile-identity-title" class="h4 mb-1">@Model.Name @Model.LastName</h2>
                        <p class="profile-identity__username mb-1">@("@" + Model.UserName)</p>
                        <p class="profile-identity__description mb-0">
                            Puedes cambiar tu foto de perfil en la sección Datos personales.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <section class="card profile-card mb-4" aria-labelledby="profile-account-title">
            <div class="card-body">
                <div class="profile-section-header">
                    <h2 id="profile-account-title" class="h5 mb-1">Información de la cuenta</h2>
                    <p class="text-muted mb-0 small">Datos asociados a tu cuenta de LinkUp Pro.</p>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label for="profileUserName" class="form-label">Nombre de usuario</label>
                        <input id="profileUserName" type="text" value="@Model.UserName"
                               class="form-control profile-readonly" readonly />
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="profileEmail" class="form-label">Correo electrónico</label>
                        <input id="profileEmail" type="email" value="@Model.Email"
                               class="form-control profile-readonly" readonly />
                    </div>
                </div>
            </div>
        </section>

        <section class="card profile-card mb-4" aria-labelledby="profile-details-title">
            <div class="card-body">
                <div class="profile-section-header">
                    <h2 id="profile-details-title" class="h5 mb-1">Datos personales</h2>
                    <p class="text-muted mb-0 small">Actualiza tu nombre, teléfono o fotografía.</p>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Name" class="form-label">Nombre</label>
                        <input asp-for="Name" class="form-control" autocomplete="given-name" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="LastName" class="form-label">Apellido</label>
                        <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Phone" class="form-label">Teléfono</label>
                        <input asp-for="Phone" class="form-control" autocomplete="tel" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="ProfileImageFile" class="form-label">Cambiar foto de perfil</label>
                        <input asp-for="ProfileImageFile" type="file"
                               accept=".jpg,.jpeg,.png,.webp" class="form-control" />
                        <div class="form-text">Formatos permitidos: JPG, PNG o WEBP. Tamaño máximo: 5 MB.</div>
                        <span asp-validation-for="ProfileImageFile" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </section>

        <section class="card profile-card mb-4" aria-labelledby="profile-security-title">
            <div class="card-body">
                <div class="profile-section-header">
                    <h2 id="profile-security-title" class="h5 mb-1">Seguridad y contraseña</h2>
                    <p class="text-muted mb-0 small">
                        El cambio de contraseña es opcional. Si no deseas cambiarla, deja los tres campos vacíos.
                    </p>
                </div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="CurrentPassword" class="form-label">Contraseña actual</label>
                        <div class="input-group">
                            <input asp-for="CurrentPassword" type="password" class="form-control"
                                   autocomplete="current-password" />
                            <button type="button" class="btn btn-outline-secondary profile-password-toggle"
                                    data-password-target="CurrentPassword" aria-controls="CurrentPassword"
                                    aria-pressed="false">Mostrar</button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="NewPassword" class="form-label">Nueva contraseña</label>
                        <div class="input-group">
                            <input asp-for="NewPassword" type="password" class="form-control"
                                   autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary profile-password-toggle"
                                    data-password-target="NewPassword" aria-controls="NewPassword"
                                    aria-pressed="false">Mostrar</button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>

                        <div class="profile-strength mt-3">
                            <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                                <span class="form-label mb-0">Fortaleza de la contraseña</span>
                            </div>
                            <div class="progress profile-strength__track">
                                <div id="passwordStrengthBar" class="progress-bar w-0" role="progressbar"
                                     aria-label="Fortaleza de la contraseña" aria-valuenow="0"
                                     aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <div id="passwordStrengthLabel" class="form-text" role="status" aria-live="polite">
                                Fortaleza: Sin evaluar
                            </div>
                            <p class="form-text mb-0">
                                Mínimo 8 caracteres, una mayúscula, una minúscula,
                                un número y un carácter especial.
                            </p>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label">Confirmar contraseña</label>
                        <div class="input-group">
                            <input asp-for="ConfirmPassword" type="password" class="form-control"
                                   autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary profile-password-toggle"
                                    data-password-target="ConfirmPassword" aria-controls="ConfirmPassword"
                                    aria-pressed="false">Mostrar</button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <div id="passwordChangeMessage" class="form-text profile-password-message mt-3"
                     role="status" aria-live="polite"></div>

                <p class="profile-security-note mb-0 mt-3">
                    Si cambias la contraseña, se cerrará tu sesión y deberás iniciar sesión nuevamente.
                </p>
            </div>
        </section>

        <div class="profile-form-actions d-flex flex-wrap gap-2 justify-content-end">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Volver atrás</a>
            <button id="profileSubmitButton" type="submit" class="btn btn-primary">Guardar cambios</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Profile/Index.js" asp-append-version="true"></script>
}

@model EditUserViewModel
@{
    ViewData["Title"] = "Mi perfil";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/Home/Index.css" asp-append-version="true" />
}

<div class="container mt-4">
    <h2 class="mb-4">Mi perfil</h2>

    <div class="card mb-4">
        <div class="card-body d-flex flex-wrap align-items-center gap-3">
            <img src="@SocialDisplay.ImageUrl(Url, Model.ProfileImagePath)" alt="Foto de perfil de @Model.UserName"
                 class="profile-image-lg rounded-circle" />
            <div>
                <h4 class="card-title mb-1">@Model.Name @Model.LastName</h4>
                <p class="text-muted mb-0">@("@" + Model.UserName) · @Model.Email</p>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-controller="Profile" asp-action="Index" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <h5 class="card-title mb-3">Información personal</h5>
                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-6">
                        <label asp-for="Name" class="form-label">Nombre</label>
                        <input asp-for="Name" class="form-control" autocomplete="given-name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="LastName" class="form-label">Apellido</label>
                        <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Phone" class="form-label">Teléfono</label>
                        <input asp-for="Phone" class="form-control" placeholder="809-555-1234" autocomplete="tel" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="ProfileImageFile" class="form-label">Nueva foto de perfil (opcional)</label>
                        <input asp-for="ProfileImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        <small class="text-muted">JPG, JPEG, PNG o WEBP. Máximo 5 MB. Si no selecciona una, se conserva la actual.</small>
                        <span asp-validation-for="ProfileImageFile" class="text-danger d-block"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="email-readonly">Correo electrónico</label>
                        <input id="email-readonly" class="form-control" value="@Model.Email" readonly disabled />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="username-readonly">Nombre de usuario</label>
                        <input id="username-readonly" class="form-control" value="@Model.UserName" readonly disabled />
                    </div>
                </div>

                <h5 class="card-title mb-1">Cambiar contraseña</h5>
                <p class="text-muted small mb-3">Opcional. Deje los tres campos vacíos para conservar su contraseña actual.</p>
                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-4">
                        <label asp-for="CurrentPassword" class="form-label">Contraseña actual</label>
                        <div class="input-group">
                            <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
                            <button type="button" class="btn btn-outline-secondary" data-toggle-password="CurrentPassword" aria-label="Mostrar contraseña">Mostrar</button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="NewPassword" class="form-label">Nueva contraseña</label>
                        <div class="input-group">
                            <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary" data-toggle-password="NewPassword" aria-label="Mostrar contraseña">Mostrar</button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                        <partial name="_PasswordStrength" model="@("NewPassword")" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="ConfirmPassword" class="form-label">Confirmar contraseña</label>
                        <div class="input-group">
                            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary" data-toggle-password="ConfirmPassword" aria-label="Mostrar contraseña">Mostrar</button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Volver atrás</a>
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Account/Password.js" asp-append-version="true"></script>
}

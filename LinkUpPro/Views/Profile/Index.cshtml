
@model EditUserViewModel

@{
    ViewData["Title"] = "Mi Perfil";

    string profileImagePath = string.IsNullOrWhiteSpace(Model.ProfileImagePath)
            ? Url.Content("~/Images/Defaults/default-profile.png")
            : Url.Content($"~/{Model.ProfileImagePath}");
}

<div class="container mt-4">
    <h2 class="mb-4">Mi Perfil</h2>

    <div class="card">
        <div class="card-body">

            <div class="text-center mb-4">
                <img src="@profileImagePath" alt="Foto de perfil" width="120" height="120"
                     class="rounded-circle img-thumbnail" />
            </div>

            <form asp-controller="Profile" asp-action="Edit" method="post"
                  enctype="multipart/form-data" asp-antiforgery="true">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nombre de usuario</label>
                        <input value="@Model.UserName" class="form-control" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Correo electrónico</label>
                        <input value="@Model.Email" class="form-control" readonly />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">Nombre</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label">Apellido</label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Phone" class="form-label">Teléfono</label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ProfileImageFile" class="form-label">
                            Cambiar foto de perfil
                        </label>
                        <input asp-for="ProfileImageFile" type="file" accept=".jpg,.jpeg,.png,.webp"
                               class="form-control" />
                        <span asp-validation-for="ProfileImageFile" class="text-danger"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <h5 class="mb-3">Cambiar contraseña (opcional)</h5>

                <p class="text-muted">
                    Si no deseas cambiar tu contraseña,
                    deja los tres campos siguientes vacíos.
                </p>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="CurrentPassword" class="form-label">
                            Contraseña actual
                        </label>

                        <div class="input-group">
                            <input asp-for="CurrentPassword" type="password"
                                   class="form-control" autocomplete="current-password" />

                            <button type="button" class="btn btn-outline-secondary"
                                    data-password-target="CurrentPassword"
                                    aria-controls="CurrentPassword" aria-pressed="false">
                                Mostrar
                            </button>
                        </div>

                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NewPassword" class="form-label">Nueva contraseña</label>

                        <div class="input-group">
                            <input asp-for="NewPassword" type="password"
                                   class="form-control" autocomplete="new-password" />

                            <button type="button" class="btn btn-outline-secondary"
                                    data-password-target="NewPassword"
                                    aria-controls="NewPassword" aria-pressed="false">
                                Mostrar
                            </button>
                        </div>

                        <span asp-validation-for="NewPassword" class="text-danger"></span>

                        <div class="mt-3">
                            <label class="form-label">
                                Fortaleza de la contraseña
                            </label>

                            <div class="progress">
                                <div id="passwordStrengthBar" class="progress-bar w-0"
                                     role="progressbar" aria-label="Fortaleza de la contraseña"
                                     aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                                </div>
                            </div>

                            <div id="passwordStrengthLabel" class="form-text"
                                 role="status" aria-live="polite">
                                Fortaleza: Sin evaluar
                            </div>

                            <small class="text-muted">
                                Mínimo 8 caracteres, una mayúscula,
                                una minúscula, un número y
                                un carácter especial.
                            </small>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label">
                            Confirmar contraseña
                        </label>

                        <div class="input-group">
                            <input asp-for="ConfirmPassword" type="password"
                                   class="form-control" autocomplete="new-password" />

                            <button type="button" class="btn btn-outline-secondary"
                                    data-password-target="ConfirmPassword"
                                    aria-controls="ConfirmPassword" aria-pressed="false">
                                Mostrar
                            </button>
                        </div>

                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <div id="passwordChangeMessage" class="form-text mt-3"
                     role="status" aria-live="polite">
                </div>

                <div class="d-flex gap-2 mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                        Volver atrás
                    </a>

                    <button id="profileSubmitButton" type="submit" class="btn btn-primary">
                        Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Profile/Index.js" asp-append-version="true"></script>
}

@model LinkUpPro.Core.Application.ViewModels.Comment.DeleteCommentViewModel

@{
    ViewData["Title"] = "Eliminar comentario";

    string returnUrl = Url.IsLocalUrl(Model.ReturnUrl) ? Model.ReturnUrl! : Url.Action("Index", "Home") ?? "/";
}

<div class="container mt-4">
    <h2 class="mb-4">Eliminar comentario</h2>

    <div class="card">
        <div class="card-body">
            <p>¿Está seguro que desea eliminar este comentario?</p>

            <form asp-controller="Comment" asp-action="Delete" method="post">

                <input asp-for="Id" type="hidden" />

                <input asp-for="ReturnUrl" type="hidden" value="@returnUrl" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="d-flex gap-2">
                    <a href="@returnUrl" class="btn btn-secondary">Cancelar</a>

                    <button type="submit" class="btn btn-danger">Aceptar</button>
                </div>
            </form>
        </div>
    </div>
</div>
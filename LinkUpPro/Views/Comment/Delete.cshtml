@model LinkUpPro.Core.Application.ViewModels.Comment.DeleteCommentViewModel

@{
    ViewData["Title"] = "Eliminar comentario";
    string returnUrl = Url.IsLocalUrl(Model.ReturnUrl)
        ? Model.ReturnUrl!
        : Url.Action("Index", "Home") ?? "/";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Comment/Comments.css" asp-append-version="true" />
}

<div class="comment-form-page comment-form-page--confirm">
    <h1 class="mb-4">Eliminar comentario</h1>
    <div class="card comment-form-card">
        <div class="card-body">
            <p class="mb-4">¿Está seguro que desea eliminar este comentario?</p>
            <form asp-controller="Comment" asp-action="Delete" method="post">
                <input asp-for="Id" type="hidden" />
                <input asp-for="ReturnUrl" type="hidden" value="@returnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="d-flex flex-wrap gap-2">
                    <a href="@returnUrl" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-danger">Aceptar</button>
                </div>
            </form>
        </div>
    </div>
</div>

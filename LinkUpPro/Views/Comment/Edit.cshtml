@model LinkUpPro.Core.Application.ViewModels.Comment.UpdateCommentViewModel

@{
    ViewData["Title"] = "Editar comentario";
    int commentId = (int)(ViewData["CommentId"] ?? 0);
    string returnUrl = ViewData["ReturnUrl"]?.ToString() ?? Url.Action("Index", "Home")!;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Comment/Comments.css" asp-append-version="true" />
}

<div class="comment-form-page">
    <h1 class="mb-4">Editar comentario</h1>
    <div class="card comment-form-card">
        <div class="card-body">
            <form asp-controller="Comment" asp-action="Edit" asp-route-commentId="@commentId" method="post">
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-4">
                    <label asp-for="Content" class="form-label">Contenido</label>
                    <textarea asp-for="Content" class="form-control" rows="4" maxlength="500"></textarea>
                    <span asp-validation-for="Content" class="text-danger small"></span>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a href="@returnUrl" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@model LinkUpPro.Core.Application.ViewModels.Comment.CreateCommentViewModel

@{
    string contentId = $"comment-content-{Model.PostId}-{Model.ParentCommentId?.ToString() ?? "main"}";
    string? error = ViewData["CommentError"]?.ToString();

    bool hasError = !string.IsNullOrWhiteSpace(error) &&
        ViewData["CommentPostId"]?.ToString() == Model.PostId.ToString() &&
        (ViewData["CommentParentId"]?.ToString() ?? "") == (Model.ParentCommentId?.ToString() ?? "");

    if (hasError)
    {
        Model.Content = ViewData["CommentContent"]?.ToString() ?? "";
    }
}

<form asp-controller="Comment" asp-action="Create" method="post" class="comment-compose mt-3">
    <input type="hidden" name="PostId" value="@Model.PostId" />
    @if (Model.ParentCommentId.HasValue)
    {
        <input type="hidden" name="ParentCommentId" value="@Model.ParentCommentId.Value" />
    }
    <input type="hidden" asp-for="ReturnUrl"
           value="@(Context.Request.Path.ToString() + Context.Request.QueryString.ToString())" />

    <div class="mb-2">
        <label asp-for="Content" for="@contentId" class="form-label">
            @(Model.ParentCommentId.HasValue ? "Tu respuesta" : "Tu comentario")
        </label>
        <textarea asp-for="Content" id="@contentId" class="form-control" rows="2" maxlength="500"
                  placeholder="Escribe un comentario..."></textarea>
        <span asp-validation-for="Content" class="text-danger small"></span>
        @if (hasError)
        {
            <div class="text-danger small mt-2" role="alert">@error</div>
        }
    </div>
    <button type="submit" class="btn btn-primary btn-sm">
        @(Model.ParentCommentId.HasValue ? "Responder" : "Comentar")
    </button>
</form>

@using LinkUpPro.Core.Domain.Enums

@model LinkUpPro.Core.Application.ViewModels.Home.HomeViewModel

@{
    ViewData["Title"] = "Home";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/Home/Index.css" asp-append-version="true" />
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title mb-3">Buscar publicaciones</h5>
        <form asp-controller="Home" asp-action="Index" method="get">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="Filter.SearchText" class="form-label">Contenido</label>
                    <input asp-for="Filter.SearchText" class="form-control" placeholder="Buscar por contenido" />
                    <span asp-validation-for="Filter.SearchText"
                          class="text-danger"></span>
                </div>
                <div class="col-12 col-md-3">
                    <label asp-for="Filter.MediaType" class="form-label">Tipo de publicación</label>
                    <select asp-for="Filter.MediaType" class="form-select">
                        <option value="">Todos</option>
                        <option value="@PostMediaType.Image">Imagen</option>
                        <option value="@PostMediaType.YouTubeVideo">Video de YouTube</option>
                    </select>
                    <span asp-validation-for="Filter.MediaType" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-3">
                    <label asp-for="Filter.IsEdited" class="form-label">Estado de edición</label>
                    <select asp-for="Filter.IsEdited" class="form-select">
                        <option value="">Todas</option>
                        <option value="true">Editadas</option>
                        <option value="false">No editadas</option>
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Filter.StartDate" class="form-label">Fecha inicial</label>
                    <input asp-for="Filter.StartDate" type="date" class="form-control" />
                    <span asp-validation-for="Filter.StartDate" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Filter.EndDate" class="form-label">Fecha final</label>
                    <input asp-for="Filter.EndDate" type="date" class="form-control" />
                    <span asp-validation-for="Filter.EndDate" class="text-danger"></span>
                </div>
                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Buscar</button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Limpiar filtros</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="container mt-4">
    <h2 class="mb-4">Mis publicaciones</h2>

    <partial name="~/Views/Home/_CreatePostForm.cshtml" model="Model.CreatePost" />

    @if (Model.Posts.Count == 0)
    {
        <div class="text-center mt-4">
            <p>Todavía no ha realizado ninguna publicación.</p>
        </div>
    }
    else
    {
        foreach (var post in Model.Posts)
        {
            <div class="card mb-3">
                <div class="card-body">

                    <div class="d-flex align-items-center mb-3">
                        @{
                            string profileImagePath = string.IsNullOrWhiteSpace(post.UserProfilePicturePath)
                                ? Url.Content("~/Images/Defaults/default-profile.png")
                                : Url.Content($"~/{post.UserProfilePicturePath}");
                        }

                        <img src="@profileImagePath"
                             alt="Foto de perfil de @post.UserName"
                             class="post-profile-image rounded-circle me-3" />

                        <div>
                            <h5 class="card-title mb-1">@post.UserName</h5>

                            <small class="text-muted">
                                @post.CreatedAt.ToString("dd/MM/yyyy HH:mm") UTC
                            </small>
                        </div>
                    </div>

                    <p class="card-text">@post.Content</p>

                    <div class="mb-3">
                        <span class="badge bg-secondary">@(post.Privacy == PostPrivacy.FriendsOnly ? "Solo amigos" : "Solo yo")</span>
                        @if (post.AllowComments)
                        {
                            <span class="badge bg-success">Comentarios permitidos</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Comentarios desactivados</span>
                        }

                    </div>

                    @if (post.MediaType == PostMediaType.Image && !string.IsNullOrWhiteSpace(post.ImagePath))
                    {
                        <div class="mb-3">
                            <img src="@Url.Content($"~/{post.ImagePath}")" alt="Imagen de la publicación" class="img-fluid rounded" />
                        </div>
                    }

                    @if (post.MediaType == PostMediaType.YouTubeVideo && !string.IsNullOrWhiteSpace(post.YouTubeEmbedUrl))
                    {
                        <div class="ratio ratio-16x9 mb-3">
                            <iframe src="@post.YouTubeEmbedUrl"
                                    title="Video de YouTube"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                    referrerpolicy="strict-origin-when-cross-origin"
                                    allowfullscreen>
                            </iframe>
                        </div>
                    }

                    @if (post.UpdatedAt.HasValue)
                    {
                        <small class="text-muted">Editada</small>
                    }

                    <div class="mt-3">
                        <span class="me-3">
                            Me gusta: @post.LikesCount
                        </span>

                        <span class="me-3">
                            No me gusta: @post.DislikesCount
                        </span>

                        <span>
                            Comentarios: @post.CommentsCount
                        </span>
                    </div>
                    <div class="mt-3">
                        <a asp-controller="Post" asp-action="Edit" asp-route-postId="@post.Id" class="btn btn-warning">Editar</a>
                        <a asp-controller="Post" asp-action="Delete" asp-route-postId="@post.Id" class="btn btn-danger">Eliminar</a>
                    </div>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Home/Index.js" asp-append-version="true"></script>
}
@model LinkUpPro.Core.Application.ViewModels.Post.DeletePostViewModel

@{
    ViewData["Title"] = "Eliminar publicación";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Post/Posts.css" asp-append-version="true" />
}

<div class="post-form-page post-form-page--confirm">
    <h1 class="mb-4">Eliminar publicación</h1>
    <div class="card post-form-card">
        <div class="card-body">
            <p class="mb-4">¿Está seguro que desea eliminar esta publicación?</p>
            <form asp-controller="Post" asp-action="Delete" method="post">
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-danger">Aceptar</button>
                </div>
            </form>
        </div>
    </div>
</div>

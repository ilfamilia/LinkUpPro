@model LinkUpPro.Core.Application.ViewModels.Post.DeletePostViewModel

@{
    ViewData["Title"] = "Eliminar publicación";
}

<div class="container mt-4">
    <h2 class="mb-4">Eliminar publicación</h2>
    <div class="card">
        <div class="card-body">
            <p>¿Está seguro que desea eliminar esta publicación?</p>
            <form asp-controller="Post" asp-action="Delete" method="post">
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="d-flex gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-danger">Aceptar</button>
                </div>
            </form>
        </div>
    </div>
</div>
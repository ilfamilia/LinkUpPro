@model LinkUpPro.Core.Application.ViewModels.FriendshipRequest.NewFriendshipRequestViewModel

@{
    ViewData["Title"] = "Nueva solicitud de amistad";
}

<div class="container my-4">
    <h2>Nueva solicitud de amistad</h2>

    <form asp-action="New" method="get" class="row g-2 align-items-end my-3">
        <div class="col-md-7">
            <label asp-for="UserNameFilter" class="form-label">Nombre de usuario</label>
            <input asp-for="UserNameFilter" class="form-control"
                   placeholder="Buscar por nombre de usuario" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Buscar</button>
        </div>
        <div class="col-auto">
            <a asp-action="New" class="btn btn-outline-secondary">Limpiar búsqueda</a>
        </div>
    </form>

    <form asp-action="Send" method="post" asp-antiforgery="true">
        <input type="hidden" name="UserNameFilter" value="@Model.UserNameFilter" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <span asp-validation-for="SelectedUserId" class="text-danger"></span>

        @if (Model.Users.Count == 0)
        {
            <p class="text-muted">
                @(string.IsNullOrWhiteSpace(Model.UserNameFilter)
                    ? "No existen usuarios disponibles para enviar una solicitud de amistad."
                    : "No se encontraron usuarios disponibles con el nombre ingresado.")
            </p>
        }
        else
        {
            <div class="row g-3 mb-4">
                @foreach (var available in Model.Users)
                {
                    <div class="col-12 col-lg-6">
                        <div class="card h-100">
                            <div class="card-body d-flex align-items-center gap-3">
                                <input type="radio" name="SelectedUserId" id="user-@available.User.Id"
                                       value="@available.User.Id"
                                       checked="@(Model.SelectedUserId == available.User.Id)"
                                       class="form-check-input flex-shrink-0"
                                       aria-label="Seleccionar a @available.User.UserName" />
                                <div class="flex-grow-1">
                                    <partial name="_FriendshipUser" model="available.User" />
                                    <a asp-action="MutualFriends"
                                       asp-route-otherUserId="@available.User.Id"
                                       class="small d-inline-block mt-2">
                                        Amigos en común: @available.MutualFriendsCount
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-secondary">Volver atrás</a>
            <button type="submit" class="btn btn-primary"
                    disabled="@(Model.Users.Count == 0)">
                Enviar solicitud
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

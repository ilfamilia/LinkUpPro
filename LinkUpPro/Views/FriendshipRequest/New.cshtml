@model LinkUpPro.Core.Application.ViewModels.FriendshipRequest.NewFriendshipRequestViewModel

@{
    ViewData["Title"] = "Nueva solicitud de amistad";
}

@section Styles {
    <link rel="stylesheet" href="~/css/FriendshipRequest/Index.css" asp-append-version="true" />
}

<div class="request-page my-4">
    <header class="request-page__intro">
        <h1 class="mb-1">Nueva solicitud de amistad</h1>
        <p class="text-muted mb-0">Busca un usuario y selecciónalo para enviarle una solicitud.</p>
    </header>

    <div class="card request-form-card mb-4">
        <div class="card-body">
            <h2 class="h5 mb-3">Buscar usuarios</h2>
            <form asp-action="New" method="get" class="row g-3 align-items-end">
                <div class="col-12 col-md-7">
                    <label asp-for="UserNameFilter" class="form-label">Nombre de usuario</label>
                    <input asp-for="UserNameFilter" class="form-control"
                           placeholder="Buscar por nombre de usuario" />
                </div>
                <div class="col-12 col-md-5 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary">Buscar</button>
                    <a asp-action="New" class="btn btn-outline-secondary">Limpiar búsqueda</a>
                </div>
            </form>
        </div>
    </div>

    <form asp-action="Send" method="post" asp-antiforgery="true">
        <input type="hidden" name="UserNameFilter" value="@Model.UserNameFilter" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <span asp-validation-for="SelectedUserId" class="text-danger small d-block mb-3"></span>

        <h2 class="h5 mb-3">Usuarios disponibles</h2>
        @if (Model.Users.Count == 0)
        {
            <div class="request-empty-state mb-4" role="status">
                <p>
                    @(string.IsNullOrWhiteSpace(Model.UserNameFilter)
                        ? "No existen usuarios disponibles para enviar una solicitud de amistad."
                        : "No se encontraron usuarios disponibles con el nombre ingresado.")
                </p>
            </div>
        }
        else
        {
            <div class="row g-3 mb-4">
                @foreach (var available in Model.Users)
                {
                    <div class="col-12 col-lg-6">
                        <div class="card request-card request-select-card h-100">
                            <div class="card-body d-flex align-items-center gap-3">
                                <input type="radio" name="SelectedUserId" id="user-@available.User.Id"
                                       value="@available.User.Id"
                                       checked="@(Model.SelectedUserId == available.User.Id)"
                                       class="form-check-input flex-shrink-0"
                                       aria-label="Seleccionar a @available.User.UserName" />
                                <div class="flex-grow-1 request-user__identity">
                                    <partial name="_FriendshipUser" model="available.User" />
                                    <a asp-action="MutualFriends"
                                       asp-route-otherUserId="@available.User.Id"
                                       class="small d-inline-block mt-2">
                                        Amigos en común: @available.MutualFriendsCount
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Volver atrás</a>
            <button type="submit" class="btn btn-primary" disabled="@(Model.Users.Count == 0)">
                Enviar solicitud
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

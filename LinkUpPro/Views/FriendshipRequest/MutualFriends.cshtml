@model List<LinkUpPro.Core.Application.ViewModels.FriendshipRequest.FriendshipUserViewModel>

@{
    ViewData["Title"] = "Amigos en común";
}

@section Styles {
    <link rel="stylesheet" href="~/css/FriendshipRequest/Index.css" asp-append-version="true" />
}

<div class="request-page my-4">
    <header class="request-page__intro">
        <h1 class="mb-1">Amigos en común</h1>
        <p class="text-muted mb-0">Consulta las amistades que comparten.</p>
    </header>

    @if (Model.Count == 0)
    {
        <div class="request-empty-state" role="status"><p>No tienen amigos en común.</p></div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var friend in Model)
            {
                <div class="col-12 col-md-6">
                    <div class="card request-card h-100">
                        <div class="card-body">
                            <partial name="_FriendshipUser" model="friend" />
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <a asp-action="Index" class="btn btn-outline-secondary mt-4">Volver atrás</a>
</div>

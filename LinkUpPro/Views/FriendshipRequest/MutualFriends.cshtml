@model List<LinkUpPro.Core.Application.ViewModels.FriendshipRequest.FriendshipUserViewModel>

@{
    ViewData["Title"] = "Amigos en común";
}

<div class="container my-4">
    <h2>Amigos en común</h2>

    @if (Model.Count == 0)
    {
        <p class="text-muted">No tienen amigos en común.</p>
    }
    else
    {
        <div class="row g-3 mt-2">
            @foreach (var friend in Model)
            {
                <div class="col-12 col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <partial name="_FriendshipUser" model="friend" />
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <a asp-action="Index" class="btn btn-secondary mt-4">Volver atrás</a>
</div>

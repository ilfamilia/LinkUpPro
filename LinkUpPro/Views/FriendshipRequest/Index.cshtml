@model LinkUpPro.Core.Application.ViewModels.FriendshipRequest.FriendshipRequestIndexViewModel
@using LinkUpPro.Core.Domain.Enums

@{
    ViewData["Title"] = "Solicitudes de amistad";
}

@section Styles {
    <link rel="stylesheet" href="~/css/FriendshipRequest/Index.css" asp-append-version="true" />
}

<div class="request-page my-4">
    <header class="request-page__intro">
        <h1 class="mb-1">Solicitudes de amistad</h1>
        <p class="text-muted mb-0">Administra las solicitudes recibidas y enviadas.</p>
    </header>

    @if (TempData["FriendshipRequestSuccess"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["FriendshipRequestError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <section class="request-page__section" aria-labelledby="received-title">
        <div class="request-page__section-header">
            <h2 id="received-title" class="h4 mb-0">
                Pendientes de responder (@Model.ReceivedPendingCount)
            </h2>
        </div>

        @if (Model.ReceivedPending.Count == 0)
        {
            <div class="request-empty-state" role="status">
                <p>No tiene solicitudes de amistad pendientes de responder.</p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var request in Model.ReceivedPending)
                {
                    <div class="col-12 col-lg-6">
                        <article class="card request-card h-100">
                            <div class="card-body d-flex flex-column">
                                <partial name="_FriendshipUser" model="request.OtherUser" />
                                <div class="request-card__meta mt-3">
                                    Enviada: @request.RequestedAt.ToString("dd/MM/yyyy HH:mm") UTC
                                </div>
                                <a asp-action="MutualFriends"
                                   asp-route-otherUserId="@request.OtherUser.Id"
                                   class="d-inline-block mt-2 small align-self-start">
                                    Amigos en común: @request.MutualFriendsCount
                                </a>
                                <div class="request-card__actions mt-auto pt-3">
                                    <a asp-action="Confirm" asp-route-requestId="@request.Id"
                                       asp-route-operation="Accept" class="btn btn-success btn-sm">
                                        Aceptar
                                    </a>
                                    <a asp-action="Confirm" asp-route-requestId="@request.Id"
                                       asp-route-operation="Reject" class="btn btn-outline-danger btn-sm">
                                        Rechazar
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </section>

    <section class="request-page__section" aria-labelledby="sent-title">
        <div class="request-page__section-header">
            <h2 id="sent-title" class="h4 mb-0">Solicitudes enviadas</h2>
            <a asp-action="New" class="btn btn-primary">Nueva solicitud de amistad</a>
        </div>

        @if (Model.Sent.Count == 0)
        {
            <div class="request-empty-state" role="status">
                <p>No ha enviado solicitudes de amistad.</p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var request in Model.Sent)
                {
                    <div class="col-12 col-lg-6">
                        <article class="card request-card h-100">
                            <div class="card-body d-flex flex-column">
                                <partial name="_FriendshipUser" model="request.OtherUser" />
                                <div class="request-card__meta mt-3">
                                    Enviada: @request.RequestedAt.ToString("dd/MM/yyyy HH:mm") UTC
                                </div>
                                <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                                    <span class="request-card__meta">Estado:</span>
                                    <span class="request-status @(request.Status switch
                                        {
                                            FriendshipRequestStatus.Pending => "request-status--pending",
                                            FriendshipRequestStatus.Accepted => "request-status--accepted",
                                            FriendshipRequestStatus.Rejected => "request-status--rejected",
                                            _ => "request-status--cancelled"
                                        })">
                                        @(request.Status switch
                                        {
                                            FriendshipRequestStatus.Pending => "En espera de respuesta",
                                            FriendshipRequestStatus.Accepted => "Aceptada",
                                            FriendshipRequestStatus.Rejected => "Rechazada",
                                            _ => "Cancelada"
                                        })
                                    </span>
                                </div>
                                @if (request.RespondedAt.HasValue)
                                {
                                    <div class="request-card__meta mt-2">
                                        Respondida: @request.RespondedAt.Value.ToString("dd/MM/yyyy HH:mm") UTC
                                    </div>
                                }
                                <a asp-action="MutualFriends"
                                   asp-route-otherUserId="@request.OtherUser.Id"
                                   class="d-inline-block mt-2 small align-self-start">
                                    Amigos en común: @request.MutualFriendsCount
                                </a>
                                <div class="request-card__actions mt-auto pt-3">
                                    @if (request.Status == FriendshipRequestStatus.Pending)
                                    {
                                        <a asp-action="Confirm" asp-route-requestId="@request.Id"
                                           asp-route-operation="Cancel" class="btn btn-outline-danger btn-sm">
                                            Cancelar solicitud
                                        </a>
                                    }
                                    else if (request.Status is FriendshipRequestStatus.Accepted or FriendshipRequestStatus.Rejected)
                                    {
                                        <a asp-action="Confirm" asp-route-requestId="@request.Id"
                                           asp-route-operation="Hide" class="btn btn-outline-secondary btn-sm">
                                            Eliminar del historial
                                        </a>
                                    }
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </section>
</div>

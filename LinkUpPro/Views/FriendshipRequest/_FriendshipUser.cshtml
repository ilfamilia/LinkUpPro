@model LinkUpPro.Core.Application.ViewModels.FriendshipRequest.FriendshipUserViewModel

@{
    string imagePath = string.IsNullOrWhiteSpace(Model.ProfileImage)
        ? Url.Content("~/Images/Defaults/default-profile.png")
        : Url.Content($"~/{Model.ProfileImage.TrimStart('/')}");
}

<div class="d-flex align-items-center gap-3">
    <img src="@imagePath" alt="Foto de @Model.UserName" width="52"
         height="52" class="rounded-circle border" loading="lazy" />
    <div>
        <div class="fw-semibold">@Model.Name @Model.LastName</div>
        <div class="text-muted small">@@@Model.UserName</div>
    </div>
</div>
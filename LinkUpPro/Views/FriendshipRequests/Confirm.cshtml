@model RequestActionViewModel
@* Confirms one request transition; the posted action still rechecks ownership and state. *@
@{
    ViewData["Title"] = "Confirmar solicitud";
    var message = Model.Operation switch
    {
        RequestOperation.Accept => $"¿Está seguro que desea aceptar la solicitud de amistad del usuario {Model.OtherUserName}?",
        RequestOperation.Reject => $"¿Está seguro que desea rechazar la solicitud de amistad del usuario {Model.OtherUserName}?",
        RequestOperation.Cancel => $"¿Está seguro que desea cancelar la solicitud de amistad enviada a {Model.OtherUserName}?",
        _ => "¿Está seguro que desea eliminar esta solicitud de su historial?"
    };
    var confirmLabel = Model.Operation switch
    {
        RequestOperation.Accept => "Aceptar",
        RequestOperation.Reject => "Rechazar",
        RequestOperation.Cancel => "Cancelar solicitud",
        _ => "Eliminar"
    };
    var confirmClass = Model.Operation == RequestOperation.Accept ? "btn-success" : "btn-danger";
}

<div class="container mt-4">
    <h2 class="mb-4">Confirmar solicitud</h2>
    <div class="card">
        <div class="card-body">
            <p>@message</p>
            <form asp-controller="FriendshipRequests" asp-action="Respond" method="post">
                <input asp-for="Id" type="hidden" />
                <input asp-for="Operation" type="hidden" />
                <div class="d-flex gap-2">
                    <a asp-controller="FriendshipRequests" asp-action="Index" class="btn btn-secondary">
                        @(Model.Operation == RequestOperation.Cancel ? "Volver atrás" : "Cancelar")
                    </a>
                    <button type="submit" class="btn @confirmClass">@confirmLabel</button>
                </div>
            </form>
        </div>
    </div>
</div>

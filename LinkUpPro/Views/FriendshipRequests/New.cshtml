@model NewRequestViewModel
@* Selects one eligible receiver while keeping search requests separate from mutation requests. *@
@{
    ViewData["Title"] = "Nueva solicitud de amistad";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/Home/Index.css" asp-append-version="true" />
}

<div class="container mt-4">
    <h2 class="mb-4">Nueva solicitud de amistad</h2>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">Buscar usuarios</h5>
            <form asp-controller="FriendshipRequests" asp-action="New" method="get">
                <div class="row g-3">
                    <div class="col-12 col-md-8">
                        <label for="search" class="form-label">Nombre de usuario</label>
                        <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Buscar por nombre de usuario" />
                    </div>
                    <div class="col-12 col-md-4 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary">Buscar</button>
                        <a asp-controller="FriendshipRequests" asp-action="New" class="btn btn-secondary">Limpiar búsqueda</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-controller="FriendshipRequests" asp-action="New" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <input asp-for="Search" type="hidden" />

                @if (Model.Candidates.Count == 0)
                {
                    <p class="text-muted">
                        @(string.IsNullOrWhiteSpace(Model.Search) ? "No existen usuarios disponibles para enviar una solicitud de amistad." : "No se encontraron usuarios disponibles con el nombre ingresado.")
                    </p>
                }
                else
                {
                    <ul class="list-group mb-3">
                        @foreach (var candidate in Model.Candidates)
                        {
                            <li class="list-group-item d-flex flex-wrap align-items-center gap-3">
                                <input type="radio" asp-for="SelectedUserId" value="@candidate.User.Id" id="user-@candidate.User.Id" class="form-check-input mt-0" />
                                <label for="user-@candidate.User.Id" class="d-flex align-items-center gap-3 flex-grow-1 mb-0">
                                    <img src="@SocialDisplay.ImageUrl(Url, candidate.User.ProfilePicturePath)" alt="Foto de perfil de @candidate.User.UserName"
                                         class="post-profile-image rounded-circle" />
                                    <span>
                                        <span class="fw-semibold d-block">@candidate.User.FirstName @candidate.User.LastName</span>
                                        <small class="text-muted">@("@" + candidate.User.UserName) · @candidate.MutualFriendCount amigos en común</small>
                                    </span>
                                </label>
                            </li>
                        }
                    </ul>
                }

                <div class="d-flex gap-2">
                    <a asp-controller="FriendshipRequests" asp-action="Index" class="btn btn-secondary">Volver atrás</a>
                    <button type="submit" class="btn btn-primary" disabled="@(Model.Candidates.Count == 0)">Enviar solicitud</button>
                </div>
            </form>
        </div>
    </div>
</div>

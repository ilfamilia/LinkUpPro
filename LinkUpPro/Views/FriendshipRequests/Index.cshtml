@model RequestListViewModel
@* Displays received requests and the sender's visible history without exposing state-changing GET links. *@
@{
    ViewData["Title"] = "Solicitudes de amistad";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/Home/Index.css" asp-append-version="true" />
}

<div class="container mt-4">
    <h2 class="mb-4">Solicitudes de amistad</h2>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">Solicitudes pendientes de responder</h5>

            @if (Model.Incoming.Count == 0)
            {
                <p class="text-muted mb-0">No tiene solicitudes de amistad pendientes de responder.</p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var request in Model.Incoming)
                    {
                        <li class="list-group-item d-flex flex-wrap align-items-center gap-3">
                            <partial name="_RequestUser" model="request" />
                            <div class="d-flex gap-2">
                                <a asp-controller="FriendshipRequests" asp-action="Confirm" asp-route-id="@request.Id"
                                   asp-route-operation="@RequestOperation.Accept" class="btn btn-success btn-sm">Aceptar</a>
                                <a asp-controller="FriendshipRequests" asp-action="Confirm" asp-route-id="@request.Id"
                                   asp-route-operation="@RequestOperation.Reject" class="btn btn-outline-danger btn-sm">Rechazar</a>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <h5 class="card-title mb-0">Solicitudes enviadas</h5>
                <a asp-controller="FriendshipRequests" asp-action="New" class="btn btn-primary">Nueva solicitud de amistad</a>
            </div>

            @if (Model.Sent.Count == 0)
            {
                <p class="text-muted mb-0">No ha enviado solicitudes de amistad.</p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var request in Model.Sent)
                    {
                        <li class="list-group-item d-flex flex-wrap align-items-center gap-3">
                            <partial name="_RequestUser" model="request" />
                            <div class="text-md-end">
                                <span class="badge @(request.Status switch
                                {
                                    FriendshipRequestStatus.Pending => "bg-warning text-dark",
                                    FriendshipRequestStatus.Accepted => "bg-success",
                                    _ => "bg-danger"
                                })">@SocialDisplay.RequestStatus(request.Status)</span>
                                @if (request.RespondedAt.HasValue)
                                {
                                    <small class="text-muted d-block">Respondida: @request.RespondedAt.Value.ToString("dd/MM/yyyy HH:mm") UTC</small>
                                }
                                <div class="mt-2">
                                    @if (request.Status == FriendshipRequestStatus.Pending)
                                    {
                                        <a asp-controller="FriendshipRequests" asp-action="Confirm" asp-route-id="@request.Id"
                                           asp-route-operation="@RequestOperation.Cancel" class="btn btn-outline-danger btn-sm">Cancelar solicitud</a>
                                    }
                                    else
                                    {
                                        <a asp-controller="FriendshipRequests" asp-action="Confirm" asp-route-id="@request.Id"
                                           asp-route-operation="@RequestOperation.Hide" class="btn btn-outline-secondary btn-sm">Eliminar del historial</a>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

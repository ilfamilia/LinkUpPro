@model LinkUpPro.Core.Application.ViewModels.Notification.NotificationIndexViewModel
@using LinkUpPro.Core.Domain.Enums

@{
    ViewData["Title"] = "Notificaciones";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Notification/Index.css" asp-append-version="true" />
}

<div class="container mt-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Notificaciones</h1>
            <p class="text-muted mb-0">Sin leer: @Model.UnreadCount</p>
        </div>
        @if (Model.UnreadCount > 0)
        {
            <form asp-controller="Notification" asp-action="MarkAllAsRead"
                  method="post" asp-antiforgery="true">
                <button type="submit" class="btn btn-primary">Marcar todas como leídas</button>
            </form>
        }
    </div>

    @if (TempData["NotificationWarning"] is string warning)
    {
        <div class="alert alert-warning" role="alert">@warning</div>
    }

    @if (Model.Notifications.Count == 0)
    {
        <p class="text-muted">No tiene notificaciones.</p>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var notification in Model.Notifications)
            {
                string actorImagePath = string.IsNullOrWhiteSpace(notification.ActorProfileImagePath)
                    ? Url.Content("~/Images/Defaults/default-profile.png")
                    : Url.Content($"~/{notification.ActorProfileImagePath}");

                <article class="card notification-card @(notification.IsRead ? "" : "notification-unread")">
                    <div class="card-body">
                        <div class="d-flex align-items-start gap-3">
                            <img src="@actorImagePath"
                                 alt="Foto de @notification.ActorUserName"
                                 class="notification-avatar rounded-circle" />
                            <div class="flex-grow-1">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <strong>@notification.ActorUserName</strong>
                                    <span class="badge bg-secondary">
                                        @(notification.Type switch
                                        {
                                            NotificationType.Comment => "Comentario",
                                            NotificationType.Reply => "Respuesta",
                                            _ => "Reacción"
                                        })
                                    </span>
                                    @if (!notification.IsRead)
                                    {
                                        <span class="badge bg-primary">No leída</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">Leída</span>
                                    }
                                </div>
                                <p class="mb-1 mt-2">@notification.Description</p>
                                <small class="text-muted">
                                    @notification.CreatedAt.ToString("dd/MM/yyyy HH:mm") UTC
                                </small>
                                <div class="d-flex flex-wrap gap-2 mt-3">
                                    <a asp-controller="Notification" asp-action="Open"
                                       asp-route-id="@notification.Id"
                                       class="btn btn-outline-primary btn-sm">
                                        Ver contenido
                                    </a>
                                    @if (!notification.IsRead)
                                    {
                                        <form asp-controller="Notification" asp-action="MarkAsRead"
                                              asp-route-id="@notification.Id"
                                              method="post" asp-antiforgery="true">
                                            <button type="submit" class="btn btn-outline-secondary btn-sm">
                                                Marcar como leída
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>

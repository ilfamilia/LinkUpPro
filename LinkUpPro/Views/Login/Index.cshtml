@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            <div class="card">
                <div class="card-body p-4">
                    <h2 class="mb-1 text-center">LinkUp Pro</h2>
                    <p class="text-muted text-center mb-4">Inicie sesión para continuar</p>

                    @if (TempData["LoginSuccess"] is string loginSuccess)
                    {
                        <div class="alert alert-success" role="status">@loginSuccess</div>
                    }
                    @if (ViewBag.Info is string info)
                    {
                        <div class="alert alert-info" role="status">@info</div>
                    }

                    <form asp-controller="Login" asp-action="Index" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label">Nombre de usuario</label>
                            <input asp-for="UserName" class="form-control" autocomplete="username" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Contraseña</label>
                            <div class="input-group">
                                <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
                                <button type="button" class="btn btn-outline-secondary" data-toggle-password="Password" aria-label="Mostrar contraseña">Mostrar</button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-1">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">Mantener sesión iniciada</label>
                        </div>
                        <small class="text-muted d-block mb-3">Seleccione esta opción únicamente si está utilizando un dispositivo personal.</small>

                        <button type="submit" class="btn btn-primary w-100">Iniciar sesión</button>
                    </form>

                    <hr />

                    <div class="d-flex flex-column gap-2 text-center">
                        <a asp-controller="Login" asp-action="Register" class="btn btn-outline-primary">Registrarse</a>
                        <a asp-controller="Login" asp-action="ForgotPassword">Restablecer contraseña</a>
                        <a asp-controller="Login" asp-action="ResendEmailActivation">Reenviar correo de activación</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Account/Password.js" asp-append-version="true"></script>
}

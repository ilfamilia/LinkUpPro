@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="card auth-card">
    <div class="card-body">
        <h1 class="auth-title">Iniciar sesión</h1>
        <p class="auth-description">Accede a tu cuenta para continuar.</p>

        <div class="auth-feedback" aria-live="polite">
            @if (TempData["ProfilePasswordChanged"] is string successMessage)
            {
                <div class="alert alert-success" role="status">@successMessage</div>
            }
            @if (ViewData["SessionExpired"] is true)
            {
                <div class="alert alert-warning" role="alert">
                    Su sesión finalizó por inactividad. Inicie sesión nuevamente para continuar.
                </div>
            }
            @if (TempData["PasswordResetSuccess"] is string message)
            {
                <div class="alert alert-success" role="status">@message</div>
            }
        </div>

        <form asp-controller="Login" asp-action="Index" method="post" asp-antiforgery="true">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="UserName" class="form-label">Nombre de usuario</label>
                <input asp-for="UserName" type="text" class="form-control"
                       autocomplete="username" placeholder="Ingresa tu usuario" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Contraseña</label>
                <div class="input-group">
                    <input asp-for="Password" type="password" class="form-control"
                           autocomplete="current-password" placeholder="Ingresa tu contraseña" />
                    <button id="togglePassword" type="button" class="btn btn-outline-secondary"
                            aria-label="Mostrar contraseña" aria-controls="Password" aria-pressed="false">Mostrar</button>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-1">
                <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                <label asp-for="RememberMe" class="form-check-label">Mantener sesión iniciada</label>
            </div>
            <p class="form-text mb-4">Seleccione esta opción únicamente si está utilizando un dispositivo personal.</p>

            <button type="submit" class="btn btn-primary w-100">Iniciar sesión</button>
        </form>

        <div class="auth-divider"></div>
        <div class="auth-links">
            <a asp-controller="Login" asp-action="Register">Registrarse</a>
            <a asp-controller="Login" asp-action="ForgotPassword">Restablecer contraseña</a>
            <a asp-controller="Login" asp-action="ResendEmailActivation">Reenviar correo de activación</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Login/Index.js" asp-append-version="true"></script>
}

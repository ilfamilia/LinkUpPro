@model LoginViewModel
@{
    ViewData["Title"] = "Home Page";
}

<!-- Pills navs -->
<ul class="nav nav-pills nav-justified mb-3" id="ex1" role="tablist">
  <li class="nav-item" role="presentation">
    <a class="nav-link active" id="tab-login" data-mdb-pill-init role="tab" aria-selected="true">Iniciar Sesion</a>
  </li>
  <li class="nav-item" role="presentation">
    <a class="nav-link" id="tab-register" data-mdb-pill-init asp-controller="Login" asp-action="Register" role="tab"
      aria-controls="pills-register" aria-selected="false">Registrate</a>
  </li>
</ul>
<!-- Pills navs -->

<!-- Pills content -->
<div class="tab-content">
  <div class="tab-pane fade show active" id="pills-login" role="tabpanel" aria-labelledby="tab-login">
    <form asp-controller="Login" asp-action="Index" method="POST">
      <br />
      <!-- Email input -->
      <div data-mdb-input-init class="form-outline mb-4">
        <input asp-for="UserName" type="text" class="form-control" placeholder="john_doe"/>
        <label asp-for="UserName" type="text" class="form-label">Nombre del usuario</label>
      </div>
      <!-- Password input -->
      <div data-mdb-input-init class="form-outline mb-4">
        <input asp-for="Password" type="password" class="form-control" placeholder="********"/>
        <label asp-for="Password" class="form-label" >Contraseña</label>
      </div>
      <!-- 2 column grid layout -->
      <div class="row mb-4">
        <div class="col-md-6 d-flex justify-content-center">
          <!-- Checkbox -->
          <div class="form-check mb-3 mb-md-0">
            <input asp-for="RememberMe" class="form-check-input" type="checkbox" value="" />
            <label asp-for="RememberMe" class="form-check-label">Mantener sesion iniciada</label>
          </div>
        </div>
        <div class="col-md-6 d-flex justify-content-center">
          <a asp-controller="Login" asp-action="ForgotPassword">Olvidaste tu contraseña?</a>
        </div>
      </div>
      <button type="submit" data-mdb-button-init data-mdb-ripple-init class="btn btn-primary btn-block mb-4">Iniciar Sesion</button>
    </form>
  </div>
</div>
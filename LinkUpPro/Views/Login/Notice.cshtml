@model string
@* Informative account page (registration done, invalid or expired link). *@
@{
    ViewData["Title"] = ViewData["NoticeTitle"];
    bool success = ViewData["NoticeSuccess"] is true;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card">
                <div class="card-body p-4 text-center">
                    <h2 class="mb-4">@ViewData["NoticeTitle"]</h2>
                    <div class="alert @(success ? "alert-success" : "alert-warning")" role="status">@Model</div>
                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <a asp-controller="Login" asp-action="Index" class="btn btn-primary">Ir a iniciar sesión</a>
                        @if (!success)
                        {
                            <a asp-controller="Login" asp-action="ResendEmailActivation" class="btn btn-outline-secondary">Reenviar correo de activación</a>
                            <a asp-controller="Login" asp-action="ForgotPassword" class="btn btn-outline-secondary">Restablecer contraseña</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

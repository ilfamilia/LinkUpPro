@model EmailConfirmationViewModel
@{
    ViewData["Title"] = "Reenviar correo de activación";
}

<div class="card auth-card">
    <div class="card-body">
        <h1 class="auth-title">Reenviar activación</h1>
        <p class="auth-description">Introduce tu nombre de usuario para solicitar un nuevo enlace de activación.</p>

        @if (TempData["ActivationResendMessage"] is string message)
        {
            <div class="alert alert-info" role="status">@message</div>
        }

        <form asp-controller="Login" asp-action="ResendEmailActivation" method="post" asp-antiforgery="true">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            <div class="mb-4">
                <label asp-for="UserName" class="form-label">Nombre de usuario</label>
                <input asp-for="UserName" class="form-control" autocomplete="username"
                       placeholder="Ingresa tu usuario" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Reenviar enlace</button>
        </form>

        <div class="auth-divider"></div>
        <div class="auth-links">
            <a asp-controller="Login" asp-action="Index">Volver atrás</a>
            <a asp-controller="Login" asp-action="Register">Registrarse</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

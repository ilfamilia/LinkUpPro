@model ForgotPasswordRequestViewModel
@{
    ViewData["Title"] = "Home Page";
}
<br>
<div class="card text-center">
    <div class="card-header h5 text-white bg-primary">Activar tu cuenta</div>
    <div class="card-body px-5">
        <p class="card-text py-2">
          Introduce tu nombre de usuario y te enviaremos un correo electrónico con instrucciones para activar tu cuenta.
        </p>
        <form asp-controller="Login" asp-action="ResendEmailActivation" method="POST">
          <div data-mdb-input-init class="form-outline">
              <input asp-for="UserName" type="text" class="form-control my-3" placeholder="Introduzca su nombre de usuario"/>
          </div>
          <button type="submit" data-mdb-ripple-init class="btn btn-primary w-100">Activar cuenta</button>
        </form>
        <div class="d-flex justify-content-between mt-4">
            <a class="" asp-controller="Login" asp-action="Index">Iniciar sesión</a>
            <a class="" asp-controller="Login" asp-action="Register">Registrarse</a>
        </div>
    </div>
</div>
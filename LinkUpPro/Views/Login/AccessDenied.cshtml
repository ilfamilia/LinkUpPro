@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="row justify-content-center mt-5">
    <div class="col-12 col-md-6">
        <div class="card">
            <div class="card-body text-center">

                <h4 class="card-title mb-3">Acceso denegado</h4>

                <div class="alert alert-danger">
                    No posee permisos para realizar esta acción.
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al Home</a>
                }
                else
                {
                    <a asp-controller="Login" asp-action="Index" class="btn btn-primary">Iniciar sesión</a>
                }

            </div>
        </div>
    </div>
</div>

@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="card auth-card">
    <div class="card-body text-center">
        <h1 class="auth-title">Acceso denegado</h1>
        <div class="alert alert-danger my-4" role="alert">
            No posee permisos para realizar esta acción.
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary w-100">Volver al Home</a>
        }
        else
        {
            <a asp-controller="Login" asp-action="Index" class="btn btn-primary w-100">Iniciar sesión</a>
        }
    </div>
</div>

@model ForgotPasswordRequestViewModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="card auth-card">
    <div class="card-body">
        <h1 class="auth-title">Restablecer contraseña</h1>
        <p class="auth-description">Introduce tu nombre de usuario y te enviaremos las instrucciones a tu correo electrónico.</p>

        @if (TempData["ForgotPasswordMessage"] is string successMessage)
        {
            <div class="alert alert-info" role="status">@successMessage</div>
        }
        @if (TempData["PasswordResetError"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        <form asp-controller="Login" asp-action="ForgotPassword" method="post" asp-antiforgery="true">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            <div class="mb-4">
                <label asp-for="UserName" class="form-label">Nombre de usuario</label>
                <input asp-for="UserName" class="form-control" autocomplete="username"
                       placeholder="Ingresa tu usuario" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Enviar enlace</button>
        </form>

        <div class="auth-divider"></div>
        <div class="auth-links">
            <a asp-controller="Login" asp-action="Index">Volver atrás</a>
            <a asp-controller="Login" asp-action="Register">Registrarse</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

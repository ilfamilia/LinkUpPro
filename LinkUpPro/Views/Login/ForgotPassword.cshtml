@model ForgotPasswordRequestViewModel
@{
    ViewData["Title"] = "Home Page";
}
<br>
<div class="card text-center">
    <div class="card-header h5 text-white bg-primary">Cambiar la contraseña</div>
    <div class="card-body px-5">
        <p class="card-text py-2">
          Introduce tu nombre de usuario y te enviaremos un correo electrónico con instrucciones para restablecer tu contraseña.
        </p>
        @if (TempData["ForgotPasswordMessage"] is string successMessage)
        {
            <div class="alert alert-info" role="alert">@successMessage</div>
        }

        @if (TempData["PasswordResetError"] is string errorMessage)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <form asp-controller="Login" asp-action="ForgotPassword" method="post" asp-antiforgery="true">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="UserName" class="form-label">
                    Nombre de usuario
                </label>

                <input asp-for="UserName" class="form-control" placeholder="Introduzca su nombre de usuario" />

                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Enviar enlace</button>
        </form>

        <div class="d-flex justify-content-between mt-4">
            <a class="" asp-controller="Login" asp-action="Index">Iniciar sesión</a>
            <a class="" asp-controller="Login" asp-action="Register">Registrarse</a>
        </div>
    </div>
</div>
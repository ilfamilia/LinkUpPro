@model RegisterUserViewModel
@{
    ViewData["Title"] = "Registro";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card">
                <div class="card-body p-4">
                    <h2 class="mb-4">Crear cuenta</h2>

                    <form asp-controller="Login" asp-action="Register" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="Name" class="form-label">Nombre</label>
                                <input asp-for="Name" class="form-control" autocomplete="given-name" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="LastName" class="form-label">Apellido</label>
                                <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="Phone" class="form-label">Teléfono</label>
                                <input asp-for="Phone" class="form-control" placeholder="809-555-1234" autocomplete="tel" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="Email" class="form-label">Correo electrónico</label>
                                <input asp-for="Email" class="form-control" autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="UserName" class="form-label">Nombre de usuario</label>
                                <input asp-for="UserName" class="form-control" autocomplete="username" />
                                <span asp-validation-for="UserName" class="text-danger"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="ProfileImageFile" class="form-label">Foto de perfil</label>
                                <input asp-for="ProfileImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                                <small class="text-muted">JPG, JPEG, PNG o WEBP. Máximo 5 MB.</small>
                                <span asp-validation-for="ProfileImageFile" class="text-danger d-block"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="Password" class="form-label">Contraseña</label>
                                <div class="input-group">
                                    <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                                    <button type="button" class="btn btn-outline-secondary" data-toggle-password="Password" aria-label="Mostrar contraseña">Mostrar</button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger"></span>
                                <partial name="_PasswordStrength" model="@("Password")" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label">Confirmar contraseña</label>
                                <div class="input-group">
                                    <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                                    <button type="button" class="btn btn-outline-secondary" data-toggle-password="ConfirmPassword" aria-label="Mostrar contraseña">Mostrar</button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <a asp-controller="Login" asp-action="Index" class="btn btn-secondary">Volver atrás</a>
                            <button type="submit" class="btn btn-primary">Registrarse</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Account/Password.js" asp-append-version="true"></script>
}

@model RegisterUserViewModel
@{
    ViewData["Title"] = "Regitro de Usuario";
}

<ul class="nav nav-pills nav-justified mb-3" id="ex1" role="tablist">
  <li class="nav-item" role="presentation">
    <a class="nav-link" data-mdb-pill-init asp-controller="Login" asp-action="Index" role="tab"
      aria-controls="pills-login" aria-selected="false">Inicia Sesion</a>
  </li>
  <li class="nav-item" role="presentation">
    <a class="nav-link active" data-mdb-pill-init href="#" role="tab"
      aria-controls="pills-register" aria-selected="true">Registrate</a>
  </li>
</ul>

<div class="tab-content">
   <div class="tab-pane fade show active" aria-labelledby="tab-register">
    <br />
    <form asp-controller="Login" asp-action="Register" method="POST" enctype="multipart/form-data">
      <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
      <div data-mdb-input-init class="form-outline mb-4">
        <input asp-for="Name" type="text" class="form-control" placeholder="John"/>
        <label asp-for="Name" class="form-label" >Nombre del usuario</label>
        <span asp-validation-for="Name" class="text-danger"></span>
      </div>
      <div data-mdb-input-init class="form-outline mb-4">
        <input asp-for="LastName" type="text" class="form-control" placeholder="Doe" />
        <label asp-for="LastName" class="form-label" >Apellido del usuario</label>
        <span asp-validation-for="LastName" class="text-danger"></span>
      </div>
      <div data-mdb-input-init class="form-outline mb-4">
        <input asp-for="Phone" type="text" class="form-control" placeholder="809-123-4567"/>
        <label asp-for="Phone" class="form-label" >Numero de Telefono del usuario</label>
                <span asp-validation-for="Phone" class="text-danger"></span>
      </div>
      <div data-mdb-input-init class="form-outline mb-4">
        <input asp-for="Email" type="email" class="form-control" placeholder="johndoe@example.com" />
        <label asp-for="Email" class="form-label" >Correo Electronico del usuario</label>
        <span asp-validation-for="Email" class="text-danger"></span>
      </div>
      <div data-mdb-input-init class="form-outline mb-4">
        <input asp-for="ProfileImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
        <label asp-for="ProfileImageFile" class="form-label">
            Fotografía de perfil
        </label>
        <span asp-validation-for="ProfileImageFile" class="text-danger"></span>
      </div>  
      <div data-mdb-input-init class="form-outline mb-4">
        <input asp-for="UserName" type="text" class="form-control" placeholder="john_doe" />
        <label asp-for="UserName" class="form-label" >Nombre de usuario</label>
        <span asp-validation-for="UserName" class="text-danger"></span>
      </div>
      <div class="mb-4">
        <label asp-for="Password" class="form-label">Contraseña</label>
        <div class="input-group">
            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" placeholder="Ingrese su contraseña" />
            <button type="button" class="btn btn-outline-secondary" data-password-target="Password" aria-controls="Password" aria-pressed="false">Mostrar</button>
        </div>
        <span asp-validation-for="Password" class="text-danger"></span>
        <div class="mt-3">
            <label class="form-label"> Fortaleza de la contraseña</label>
            <div class="progress">
                <div id="passwordStrengthBar" class="progress-bar w-0" role="progressbar" aria-label="Fortaleza de la contraseña"
                        aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                </div>
            </div>
            <div id="passwordStrengthLabel" class="form-text"
                    role="status" aria-live="polite"> Fortaleza: Sin evaluar
            </div>
            <small class="text-muted">
                La contraseña debe tener al menos 8 caracteres,
                una letra mayúscula, una minúscula, un número
                y un carácter especial.
            </small>
        </div>
    </div>
    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label">Confirmar contraseña</label>
        <div class="input-group">
            <input asp-for="ConfirmPassword" type="password" class="form-control"
                    autocomplete="new-password" placeholder="Confirme su contraseña" />
            <button type="button" class="btn btn-outline-secondary" data-password-target="ConfirmPassword"
                    aria-controls="ConfirmPassword" aria-pressed="false">
                Mostrar
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>
    <button id="registerSubmitButton" type="submit" class="btn btn-primary w-100 mb-3">
        Registrarse
    </button>
    </form>
  </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Login/Register.js" asp-append-version="true"></script>
}
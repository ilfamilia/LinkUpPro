@model ResetPasswordRequestViewModel
@{
    ViewData["Title"] = "Nueva contraseña";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            <div class="card">
                <div class="card-body p-4">
                    <h2 class="mb-4">Nueva contraseña</h2>

                    <form asp-controller="Login" asp-action="ResetPassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Token" />

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Nueva contraseña</label>
                            <div class="input-group">
                                <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary" data-toggle-password="Password" aria-label="Mostrar contraseña">Mostrar</button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                            <partial name="_PasswordStrength" model="@("Password")" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">Confirmar contraseña</label>
                            <div class="input-group">
                                <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary" data-toggle-password="ConfirmPassword" aria-label="Mostrar contraseña">Mostrar</button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-controller="Login" asp-action="Index" class="btn btn-secondary">Volver atrás</a>
                            <button type="submit" class="btn btn-primary">Guardar contraseña</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Account/Password.js" asp-append-version="true"></script>
}

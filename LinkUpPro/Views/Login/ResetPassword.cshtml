@model ResetPasswordRequestViewModel //a
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="col-12 col-md-6 offset-md-3 ">
    <div class="card">
        <div class="card-header bg-success text-light"><h5 class="text-center">Cambiar contraseña</h5></div>
        <div class="card-body">
            @if (ViewBag.HasError != null && ViewBag.HasError)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @foreach (var error in ViewBag.Errors)
                    {
                        <p class="text-danger">@error</p>
                    }
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>
                </div>
            }
            <form asp-controller="Login" asp-action="ResetPassword" method="post" asp-antiforgery="true">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Nueva contraseña</label>

                    <div class="input-group">
                        <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />

                        <button type="button" class="btn btn-outline-secondary" data-password-target="Password" aria-pressed="false">
                            Mostrar
                        </button>
                    </div>

                    <span asp-validation-for="Password" class="text-danger"></span>

                    <div class="mt-3">
                        <label class="form-label">Fortaleza de la contraseña</label>

                        <div class="progress">
                            <div id="passwordStrengthBar" class="progress-bar w-0" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>

                        <div id="passwordStrengthLabel" class="form-text" role="status" aria-live="polite">
                            Fortaleza: Sin evaluar
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Confirmar contraseña</label>

                    <div class="input-group">
                        <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />

                        <button type="button" class="btn btn-outline-secondary" data-password-target="ConfirmPassword"
                                aria-pressed="false">
                            Mostrar
                        </button>
                    </div>

                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="Id" />
               
                <div>
                    <button id="resetPasswordSubmitButton" type="submit" class="btn btn-outline-primary float-end"><i class="bi bi-floppy2"></i> Guardar</button>
                    <a asp-controller="Login" asp-action="Index" class="btn btn-outline-warning float-end me-2"><i class="bi bi-arrow-left-short"></i> Volver al login</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/Login/ResetPassword.js" asp-append-version="true"></script>
}
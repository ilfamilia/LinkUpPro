@using LinkUpPro.Core.Application.ViewModels.Comment
@model PostCardViewModel

@* Same card as Home: author, content, media, reactions and threaded comments of one visible post. *@
@{
    var post = Model.Post;
    string returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}#post-{post.Id}";
}

<div id="post-@post.Id" class="card mb-3">
    <div class="card-body">

        <div class="d-flex align-items-center mb-3">
            <img src="@SocialDisplay.ImageUrl(Url, Model.Author.ProfilePicturePath)"
                 alt="Foto de perfil de @Model.Author.UserName"
                 class="post-profile-image rounded-circle me-3" />

            <div>
                <h5 class="card-title mb-1">
                    @if (Model.IsOwner)
                    {
                        @Model.Author.FirstName @Model.Author.LastName
                    }
                    else
                    {
                        <a asp-controller="Friends" asp-action="Profile" asp-route-id="@Model.Author.Id" class="text-decoration-none">
                            @Model.Author.FirstName @Model.Author.LastName
                        </a>
                    }
                </h5>
                <small class="text-muted">
                    @("@" + Model.Author.UserName) · @post.CreatedAt.ToString("dd/MM/yyyy HH:mm") UTC
                </small>
            </div>
        </div>

        <p class="card-text social-text">@post.Content</p>

        <div class="mb-3">
            @if (Model.IsOwner)
            {
                <span class="badge bg-secondary">@(post.Privacy == PostPrivacy.FriendsOnly ? "Solo amigos" : "Solo yo")</span>
            }
            @if (post.AllowComments)
            {
                <span class="badge bg-success">Comentarios permitidos</span>
            }
            else
            {
                <span class="badge bg-danger">Comentarios desactivados</span>
            }
        </div>

        @if (post.MediaType == PostMediaType.Image && !string.IsNullOrWhiteSpace(post.ImagePath))
        {
            <div class="mb-3">
                <img src="@Url.Content($"~/{post.ImagePath}")" alt="Imagen de la publicación" class="img-fluid rounded" />
            </div>
        }

        @if (post.MediaType == PostMediaType.YouTubeVideo && !string.IsNullOrWhiteSpace(post.YouTubeEmbedUrl))
        {
            <div class="ratio ratio-16x9 mb-3">
                <iframe src="@post.YouTubeEmbedUrl"
                        title="Video de YouTube"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allowfullscreen>
                </iframe>
            </div>
        }

        @if (post.UpdatedAt.HasValue)
        {
            <small class="text-muted d-block mb-2">Editada</small>
        }

        <div class="d-flex gap-2 mb-3">
            <form asp-controller="Reaction" asp-action="Toggle" method="post">
                <input type="hidden" name="PostId" value="@post.Id" />
                <input type="hidden" name="ReactionType" value="@ReactionType.Like" />
                <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                <button type="submit" class="btn @(post.CurrentUserReaction == ReactionType.Like ? "btn-primary" : "btn-outline-primary")">
                    Me gusta (@post.LikesCount)
                </button>
            </form>
            <form asp-controller="Reaction" asp-action="Toggle" method="post">
                <input type="hidden" name="PostId" value="@post.Id" />
                <input type="hidden" name="ReactionType" value="@ReactionType.Dislike" />
                <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                <button type="submit" class="btn @(post.CurrentUserReaction == ReactionType.Dislike ? "btn-danger" : "btn-outline-danger")">
                    No me gusta (@post.DislikesCount)
                </button>
            </form>
        </div>

        @if (post.CurrentUserReaction.HasValue)
        {
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="text-muted">
                    Tu reacción:
                    @(post.CurrentUserReaction == ReactionType.Like ? "Me gusta" : "No me gusta")
                </span>
                <form asp-controller="Reaction" asp-action="Toggle" method="post">
                    <input type="hidden" name="PostId" value="@post.Id" />
                    <input type="hidden" name="ReactionType" value="@post.CurrentUserReaction.Value" />
                    <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Eliminar reacción</button>
                </form>
            </div>
        }

        <div id="comments-@post.Id" class="mt-3">
            <h6 class="mb-3">Comentarios (@post.CommentsCount)</h6>

            @{
                ViewData["CommentsEnabled"] = post.AllowComments;
            }

            @if (post.Comments.Count > 0)
            {
                foreach (var comment in post.Comments)
                {
                    <partial name="~/Views/Home/_CommentItem.cshtml" model="comment" />
                }
            }
            else
            {
                <p class="text-muted">Todavía no hay comentarios.</p>
            }

            @if (post.AllowComments)
            {
                <partial name="~/Views/Comment/_CreateCommentForm.cshtml" model="new CreateCommentViewModel { PostId = post.Id }" />
            }
            else
            {
                <p class="text-muted">Los comentarios están desactivados para esta publicación.</p>
            }
        </div>

        @if (Model.IsOwner)
        {
            <div class="mt-3">
                <a asp-controller="Post" asp-action="Edit" asp-route-postId="@post.Id" class="btn btn-warning">Editar</a>
                <a asp-controller="Post" asp-action="Delete" asp-route-postId="@post.Id" class="btn btn-danger">Eliminar</a>
            </div>
        }
    </div>
</div>

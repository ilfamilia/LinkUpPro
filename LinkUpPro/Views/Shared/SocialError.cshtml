@model SocialErrorViewModel
@* Shows a safe, encoded message without internal exception or resource details. *@
@{
    ViewData["Title"] = "No fue posible completar la operación";
}

<div class="container mt-4">
    <h2 class="mb-4">No fue posible completar la operación</h2>
    <div class="card">
        <div class="card-body">
            <div class="alert alert-warning mb-3" role="alert">@Model.Message</div>
            <div class="d-flex gap-2">
                <a href="javascript:history.back()" class="btn btn-secondary">Volver atrás</a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ir al Home</a>
            </div>
        </div>
    </div>
</div>

@model int
@{
    bool isActive = ViewContext.RouteData.Values["controller"]?.ToString() == "Notification";
}
<li class="nav-item">
    <a asp-controller="Notification" asp-action="Index"
       class="nav-link @(isActive ? "active" : "")"
       aria-current="@(isActive ? "page" : null)">
        Notificaciones
        @if (Model > 0)
        {
            <span class="badge app-nav-count" aria-label="@Model notificaciones no leídas">@Model</span>
        }
    </a>
</li>

@model string
@* Informative strength meter (Débil / Media / Fuerte) for the password input whose id is the model. *@
<div class="mt-2" data-strength-for="@Model">
    <div class="d-flex justify-content-between align-items-center">
        <div class="progress flex-grow-1 me-2" style="height: .4rem;">
            <div class="progress-bar" role="progressbar" style="width: 0%"></div>
        </div>
        <small class="fw-semibold" data-strength-label aria-live="polite"></small>
    </div>
    <ul class="list-unstyled small mb-0 mt-1">
        <li class="text-muted" data-rule="length">Al menos ocho caracteres</li>
        <li class="text-muted" data-rule="upper">Una letra mayúscula</li>
        <li class="text-muted" data-rule="lower">Una letra minúscula</li>
        <li class="text-muted" data-rule="digit">Al menos un número</li>
        <li class="text-muted" data-rule="special">Al menos un carácter especial</li>
    </ul>
</div>

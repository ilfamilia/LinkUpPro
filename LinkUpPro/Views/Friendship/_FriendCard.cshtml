@model LinkUpPro.Core.Application.ViewModels.Friendship.FriendViewModel

@{
    string imagePath = string.IsNullOrWhiteSpace(Model.ProfileImage)
        ? Url.Content("~/Images/Defaults/default-profile.png")
        : Url.Content($"~/{Model.ProfileImage}");
}

<div class="card h-100">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-3">
            <a asp-controller="Friendship" asp-action="Profile"
               asp-route-friendUserId="@Model.Id" aria-label="Ver perfil de @Model.UserName">
                <img src="@imagePath" alt="Foto de @Model.UserName"
                     class="friend-avatar rounded-circle" />
            </a>
            <div>
                <div class="fw-semibold">@Model.Name @Model.LastName</div>
                <a asp-controller="Friendship" asp-action="Profile"
                   asp-route-friendUserId="@Model.Id">@("@" + Model.UserName)</a>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <a asp-controller="Friendship" asp-action="MutualFriends"
               asp-route-friendUserId="@Model.Id" class="btn btn-outline-primary btn-sm">
                Amigos en común: @Model.MutualFriendsCount
            </a>
            <a asp-controller="Friendship" asp-action="Remove"
               asp-route-friendUserId="@Model.Id" class="btn btn-outline-danger btn-sm">
                Eliminar amigo
            </a>
        </div>
    </div>
</div>

@model LinkUpPro.Core.Application.ViewModels.Friendship.FriendshipProfileViewModel

@{
    ViewData["Title"] = "Perfil de amigo";
    string imagePath = string.IsNullOrWhiteSpace(Model.Friend.ProfileImage)
        ? Url.Content("~/Images/Defaults/default-profile.png")
        : Url.Content($"~/{Model.Friend.ProfileImage}");
}

@section Styles {
    <link rel="stylesheet" href="~/css/Friendship/Index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Comment/Comments.css" asp-append-version="true" />
}

<div class="container mt-4">
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex align-items-center gap-3">
                <img src="@imagePath" class="friend-avatar rounded-circle"
                     alt="Foto de @Model.Friend.UserName" />
                <div>
                    <h1 class="h4 mb-1">@Model.Friend.Name @Model.Friend.LastName</h1>
                    <div class="text-muted">@("@" + Model.Friend.UserName)</div>
                    <a asp-action="MutualFriends" asp-route-friendUserId="@Model.Friend.Id">
                        Amigos en común: @Model.Friend.MutualFriendsCount
                    </a>
                </div>
            </div>
            <div class="d-flex gap-2 mt-3">
                <a asp-action="Index" class="btn btn-secondary">Volver a Amigos</a>
                <a asp-action="Remove" asp-route-friendUserId="@Model.Friend.Id"
                   class="btn btn-outline-danger">Eliminar amigo</a>
            </div>
        </div>
    </div>

    <h2 class="h5 mb-3">Publicaciones de @Model.Friend.UserName</h2>
    @if (Model.Posts.Count == 0)
    {
        <p class="text-muted">Este amigo todavía no tiene publicaciones disponibles.</p>
    }
    else
    {
        @foreach (var post in Model.Posts)
        {
            <partial name="_FriendPost" model="post" />
        }
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

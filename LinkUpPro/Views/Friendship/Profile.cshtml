@model LinkUpPro.Core.Application.ViewModels.Friendship.FriendshipProfileViewModel

@{
    ViewData["Title"] = "Perfil de amigo";
    string imagePath = string.IsNullOrWhiteSpace(Model.Friend.ProfileImage)
        ? Url.Content("~/Images/Defaults/default-profile.png")
        : Url.Content($"~/{Model.Friend.ProfileImage}");
}

@section Styles {
    <link rel="stylesheet" href="~/css/Post/Posts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Friendship/Index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Comment/Comments.css" asp-append-version="true" />
}

<div class="friend-page my-4">
    <div class="friend-profile">
        <section class="card friend-profile__header mb-4" aria-labelledby="friend-profile-title">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <img src="@imagePath" class="friend-avatar friend-avatar--large rounded-circle"
                         alt="Foto de @Model.Friend.UserName" />
                    <div class="friend-profile__identity">
                        <h1 id="friend-profile-title" class="h4 mb-1">
                            @Model.Friend.Name @Model.Friend.LastName
                        </h1>
                        <div class="text-muted mb-1">@("@" + Model.Friend.UserName)</div>
                        <a asp-action="MutualFriends" asp-route-friendUserId="@Model.Friend.Id">
                            Amigos en común: @Model.Friend.MutualFriendsCount
                        </a>
                    </div>
                </div>
                <div class="friend-profile__actions">
                    <a asp-action="Index" class="btn btn-outline-secondary">Volver a Amigos</a>
                    <a asp-action="Remove" asp-route-friendUserId="@Model.Friend.Id"
                       class="btn btn-outline-danger">Eliminar amigo</a>
                </div>
            </div>
        </section>

        <section aria-labelledby="friend-posts-title">
            <h2 id="friend-posts-title" class="h4 mb-3">Publicaciones de @Model.Friend.UserName</h2>
            @if (Model.Posts.Count == 0)
            {
                <div class="friend-empty-state" role="status">
                    <p>Este amigo todavía no tiene publicaciones disponibles.</p>
                </div>
            }
            else
            {
                @foreach (var post in Model.Posts)
                {
                    <partial name="_FriendPost" model="post" />
                }
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model LinkUpPro.Core.Application.ViewModels.Friendship.FriendshipIndexViewModel
@using LinkUpPro.Core.Domain.Enums

@{
    ViewData["Title"] = "Amigos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Friendship/Index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Comment/Comments.css" asp-append-version="true" />
}

<div class="container mt-4">
    <h1 class="mb-4">Amigos</h1>
    @if (TempData["FriendshipSuccess"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["FriendshipError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6">Total de amigos</h2>
                    <p class="display-6 mb-0">@Model.Summary.TotalFriends</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6">Publicaciones disponibles</h2>
                    <p class="display-6 mb-0">@Model.Summary.AvailablePosts</p>
                </div>
            </div>
        </div>
    </div>

    <section aria-labelledby="friends-title" class="mb-5">
        <div class="d-flex justify-content-between flex-wrap gap-2 mb-3">
            <h2 id="friends-title" class="h4">Mis amigos</h2>
            <a asp-controller="FriendshipRequest" asp-action="Index"
               class="btn btn-outline-primary">Solicitudes de amistad</a>
        </div>
        <form asp-controller="Friendship" asp-action="Index" method="get" class="row g-2 mb-3">
            <div class="col-12 col-md-8">
                <label for="FriendSearch" class="form-label">Buscar por nombre, apellido o usuario</label>
                <input id="FriendSearch" name="FriendSearch" value="@Model.FriendSearch"
                       maxlength="100" class="form-control" />
            </div>
            <div class="col-12 col-md-4 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary">Buscar</button>
                <a asp-action="Index" class="btn btn-secondary">Limpiar búsqueda</a>
            </div>
        </form>
        @if (Model.Summary.TotalFriends == 0)
        {
            <p class="text-muted">Todavía no tiene amigos agregados.</p>
        }
        else if (Model.FilteredFriends.Count == 0)
        {
            <p class="text-muted">No se encontraron amigos que coincidan con el criterio ingresado.</p>
        }
        else
        {
            <div class="row g-3">
                @foreach (var friend in Model.FilteredFriends)
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <partial name="_FriendCard" model="friend" />
                    </div>
                }
            </div>
        }
    </section>

    <section aria-labelledby="posts-title">
        <h2 id="posts-title" class="h4 mb-3">Publicaciones de amigos</h2>
        <div class="card mb-4">
            <div class="card-body">
                <h3 class="h6">Buscar publicaciones</h3>
                <form asp-controller="Friendship" asp-action="Index" method="get">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Filter.SearchText" class="form-label">Texto de búsqueda</label>
                            <input asp-for="Filter.SearchText" class="form-control" />
                            <span asp-validation-for="Filter.SearchText" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Filter.FriendUserId" class="form-label">Amigo</label>
                            <select asp-for="Filter.FriendUserId" class="form-select">
                                <option value="">Todos los amigos</option>
                                @foreach (var friend in Model.Friends)
                                {
                                    <option value="@friend.Id">@friend.Name @friend.LastName (@friend.UserName)</option>
                                }
                            </select>
                            <span asp-validation-for="Filter.FriendUserId" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="Filter.MediaType" class="form-label">Contenido</label>
                            <select asp-for="Filter.MediaType" class="form-select">
                                <option value="">Todos</option>
                                <option value="@PostMediaType.Image">Imagen</option>
                                <option value="@PostMediaType.YouTubeVideo">Video de YouTube</option>
                            </select>
                            <span asp-validation-for="Filter.MediaType" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="Filter.StartDate" class="form-label">Fecha desde</label>
                            <input asp-for="Filter.StartDate" type="date" class="form-control" />
                            <span asp-validation-for="Filter.StartDate" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="Filter.EndDate" class="form-label">Fecha hasta</label>
                            <input asp-for="Filter.EndDate" type="date" class="form-control" />
                            <span asp-validation-for="Filter.EndDate" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Filter.IsEdited" class="form-label">Estado de edición</label>
                            <select asp-for="Filter.IsEdited" class="form-select">
                                <option value="">Todas</option>
                                <option value="true">Editadas</option>
                                <option value="false">No editadas</option>
                            </select>
                        </div>
                        <div class="col-12 d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Buscar</button>
                            <a asp-action="Index" class="btn btn-secondary">Limpiar filtros</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        @if (Model.Summary.TotalFriends == 0)
        {
            <p class="text-muted">Todavía no tiene amigos agregados.</p>
        }
        else if (Model.Posts.Count == 0)
        {
            <p class="text-muted">No se encontraron publicaciones que coincidan con los criterios seleccionados.</p>
        }
        else
        {
            @foreach (var post in Model.Posts)
            {
                <partial name="_FriendPost" model="post" />
            }
        }
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@{
    ViewData["Title"] = "Acceso de desarrollo";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Acceso de desarrollo</h4>

                    <p class="card-text">
                        Iniciar sesión con el usuario temporal de pruebas.
                    </p>

                    <form asp-controller="DevLogin"
                          asp-action="Enter"
                          method="post">

                        <input type="hidden"
                               name="returnUrl"
                               value="@ViewBag.ReturnUrl" />

                        <button type="submit" class="btn btn-primary">
                            Iniciar sesión
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
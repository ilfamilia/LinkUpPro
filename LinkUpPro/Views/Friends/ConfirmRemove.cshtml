@model SocialConfirmationViewModel
@* Confirms logical friendship removal while retaining historical interactions and games. *@
@{
    ViewData["Title"] = "Eliminar amigo";
}

<div class="container mt-4">
    <h2 class="mb-4">Eliminar amigo</h2>
    <div class="card">
        <div class="card-body">
            <p>¿Está seguro que desea eliminar de sus amigos al usuario @Model.UserName?</p>
            <form asp-controller="Friends" asp-action="Remove" method="post">
                <input name="userId" value="@Model.UserId" type="hidden" />
                <div class="d-flex gap-2">
                    <a asp-controller="Friends" asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-danger">Aceptar</button>
                </div>
            </form>
        </div>
    </div>
</div>

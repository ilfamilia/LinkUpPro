@model FriendsPageViewModel
@* Shows an authorized current friend's public profile and visible publications. *@
@{
    ViewData["Title"] = "Perfil del amigo";
    var profile = Model.Profile!;
}

@section Styles
{
    <link rel="stylesheet" href="~/css/Home/Index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Comment/Comments.css" asp-append-version="true" />
}

<div class="container mt-4">
    <h2 class="mb-4">Perfil del amigo</h2>

    <div class="card mb-4">
        <div class="card-body d-flex flex-wrap align-items-center gap-3">
            <img src="@SocialDisplay.ImageUrl(Url, profile.ProfilePicturePath)" alt="Foto de perfil de @profile.UserName"
                 class="profile-image-lg rounded-circle" />
            <div>
                <h4 class="card-title mb-1">@profile.FirstName @profile.LastName</h4>
                <p class="text-muted mb-1">@("@" + profile.UserName)</p>
                <a asp-controller="Friends" asp-action="Mutual" asp-route-id="@profile.Id" class="text-decoration-none">@Model.MutualFriendCount amigos en común</a>
            </div>
        </div>
    </div>

    <h4 class="mb-3">Publicaciones</h4>

    @if (Model.Posts.Count == 0)
    {
        <div class="text-center mt-4">
            <p>Este amigo todavía no ha realizado publicaciones disponibles para usted.</p>
        </div>
    }
    else
    {
        foreach (var card in Model.Posts)
        {
            <partial name="_PostCard" model="card" />
        }
    }

    <a asp-controller="Friends" asp-action="Index" class="btn btn-secondary">Volver atrás</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

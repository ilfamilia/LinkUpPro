@model FriendsPageViewModel
@* Combines active friendship management with a separately authorized publication feed. *@
@{
    ViewData["Title"] = "Amigos";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/Home/Index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Comment/Comments.css" asp-append-version="true" />
}

<div class="container mt-4">
    <h2 class="mb-4">Amigos</h2>

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted mb-1">Total de amigos</h6>
                    <p class="fs-3 fw-semibold mb-0">@Model.AllFriends.Count</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted mb-1">Publicaciones disponibles</h6>
                    <p class="fs-3 fw-semibold mb-0">@Model.AvailablePostCount</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">Listado de amigos</h5>
            <form asp-controller="Friends" asp-action="Index" method="get" class="mb-3">
                <div class="row g-3">
                    <div class="col-12 col-md-8">
                        <label for="friendSearch" class="form-label">Criterio de búsqueda</label>
                        <input id="friendSearch" name="friendSearch" value="@Model.FriendSearch" class="form-control"
                               placeholder="Nombre, apellido o nombre de usuario" />
                    </div>
                    <div class="col-12 col-md-4 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary">Buscar</button>
                        <a asp-controller="Friends" asp-action="Index" class="btn btn-secondary">Limpiar búsqueda</a>
                    </div>
                </div>
            </form>

            @if (Model.Friends.Count == 0)
            {
                <p class="text-muted mb-0">
                    @(Model.AllFriends.Count == 0 ? "Todavía no tiene amigos agregados." : "No se encontraron amigos que coincidan con el criterio ingresado.")
                </p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var friend in Model.Friends)
                    {
                        <li class="list-group-item d-flex flex-wrap align-items-center gap-3">
                            <a asp-controller="Friends" asp-action="Profile" asp-route-id="@friend.User.Id">
                                <img src="@SocialDisplay.ImageUrl(Url, friend.User.ProfilePicturePath)" alt="Foto de perfil de @friend.User.UserName"
                                     class="post-profile-image rounded-circle" />
                            </a>
                            <div class="flex-grow-1">
                                <div class="fw-semibold">@friend.User.FirstName @friend.User.LastName</div>
                                <a asp-controller="Friends" asp-action="Profile" asp-route-id="@friend.User.Id" class="text-decoration-none">@("@" + friend.User.UserName)</a>
                                <span class="text-muted"> · </span>
                                <a asp-controller="Friends" asp-action="Mutual" asp-route-id="@friend.User.Id" class="text-decoration-none">@friend.MutualFriendCount amigos en común</a>
                            </div>
                            <a asp-controller="Friends" asp-action="ConfirmRemove" asp-route-id="@friend.User.Id" class="btn btn-outline-danger btn-sm">Eliminar amigo</a>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <h2 class="mb-4">Publicaciones de amigos</h2>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">Buscar publicaciones</h5>
            <form asp-controller="Friends" asp-action="Index" method="get">
                <input type="hidden" name="friendSearch" value="@Model.FriendSearch" />
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Filter.Search" class="form-label">Contenido</label>
                        <input asp-for="Filter.Search" class="form-control" placeholder="Buscar por contenido" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label asp-for="Filter.FriendId" class="form-label">Amigo</label>
                        <select asp-for="Filter.FriendId" class="form-select">
                            <option value="">Todos</option>
                            @foreach (var friend in Model.AllFriends)
                            {
                                <option value="@friend.User.Id">@friend.User.UserName</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <label asp-for="Filter.MediaType" class="form-label">Tipo de publicación</label>
                        <select asp-for="Filter.MediaType" class="form-select">
                            <option value="">Todos</option>
                            <option value="@PostMediaType.Image">Imagen</option>
                            <option value="@PostMediaType.YouTubeVideo">Video de YouTube</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="Filter.From" class="form-label">Fecha inicial</label>
                        <input asp-for="Filter.From" type="date" class="form-control" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="Filter.Until" class="form-label">Fecha final</label>
                        <input asp-for="Filter.Until" type="date" class="form-control" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="Filter.IsEdited" class="form-label">Estado de edición</label>
                        <select asp-for="Filter.IsEdited" class="form-select">
                            <option value="">Todas</option>
                            <option value="true">Editadas</option>
                            <option value="false">No editadas</option>
                        </select>
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Buscar</button>
                        <a asp-controller="Friends" asp-action="Index" class="btn btn-secondary">Limpiar filtros</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Posts.Count == 0)
    {
        <div class="text-center mt-4">
            <p>
                @(Model.AllFriends.Count == 0 ? "Todavía no tiene amigos agregados."
                    : Model.AvailablePostCount == 0 ? "Sus amigos todavía no han realizado publicaciones disponibles para usted."
                    : "No se encontraron publicaciones que coincidan con los criterios seleccionados.")
            </p>
        </div>
    }
    else
    {
        foreach (var card in Model.Posts)
        {
            <partial name="_PostCard" model="card" />
        }
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

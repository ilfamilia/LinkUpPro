@model List<PublicUserViewModel>
@* Lists only people who remain active friends of both compared accounts. *@
@{
    ViewData["Title"] = "Amigos en común";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/Home/Index.css" asp-append-version="true" />
}

<div class="container mt-4">
    <h2 class="mb-4">Amigos en común</h2>

    <div class="card mb-3">
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <p class="text-muted mb-0">No tienen amigos en común.</p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var user in Model)
                    {
                        <li class="list-group-item d-flex align-items-center gap-3">
                            <a asp-controller="Friends" asp-action="Profile" asp-route-id="@user.Id">
                                <img src="@SocialDisplay.ImageUrl(Url, user.ProfilePicturePath)" alt="Foto de perfil de @user.UserName"
                                     class="post-profile-image rounded-circle" />
                            </a>
                            <div>
                                <div class="fw-semibold">@user.FirstName @user.LastName</div>
                                <a asp-controller="Friends" asp-action="Profile" asp-route-id="@user.Id" class="text-decoration-none">@("@" + user.UserName)</a>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <a href="javascript:history.back()" class="btn btn-secondary">Volver atrás</a>
</div>

@model List<NotificationItemViewModel>
@* Provides recipient-only notification navigation and antiforgery-protected read actions. *@
@{
    ViewData["Title"] = "Notificaciones";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/Home/Index.css" asp-append-version="true" />
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h2 class="mb-0">Notificaciones</h2>
        @if (Model.Any(n => !n.IsRead))
        {
            <form asp-controller="Notifications" asp-action="ReadAll" method="post">
                <button type="submit" class="btn btn-primary">Marcar todas como leídas</button>
            </form>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="text-center mt-4">
            <p>No tiene notificaciones.</p>
        </div>
    }
    else
    {
        foreach (var notification in Model)
        {
            <div class="card mb-3 @(notification.IsRead ? "" : "border-primary")">
                <div class="card-body d-flex flex-wrap align-items-center gap-3">
                    <img src="@SocialDisplay.ImageUrl(Url, notification.Actor.ProfilePicturePath)" alt="Foto de perfil de @notification.Actor.UserName"
                         class="post-profile-image rounded-circle" />

                    <div class="flex-grow-1">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="fw-semibold">@notification.Actor.UserName</span>
                            <span class="badge bg-secondary">@SocialDisplay.NotificationType(notification.Type)</span>
                            <span class="badge @(notification.IsRead ? "bg-light text-dark border" : "bg-primary")">@(notification.IsRead ? "Leída" : "No leída")</span>
                        </div>
                        <p class="mb-1">@notification.Description</p>
                        <small class="text-muted">@notification.CreatedAt.ToString("dd/MM/yyyy HH:mm") UTC</small>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-controller="Notifications" asp-action="Open" asp-route-id="@notification.Id" class="btn btn-outline-primary btn-sm">Ver contenido</a>
                        @if (!notification.IsRead)
                        {
                            <form asp-controller="Notifications" asp-action="Read" method="post">
                                <input name="id" type="hidden" value="@notification.Id" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Marcar como leída</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

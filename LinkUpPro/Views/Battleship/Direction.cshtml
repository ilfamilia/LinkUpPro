@model PlaceShipViewModel
@* Validates the chosen direction before the service checks complete ship geometry and version. *@
@{
    ViewData["Title"] = "Dirección del barco";
    var sizes = new[] { 2, 3, 3, 4, 5 };
    const string rowLabels = "ABCDEFGHIJKL";
    var board = BoardViewModel.Create("Mi tablero", Model.Id, Model.Version, (row, column) =>
        row == Model.Row && column == Model.Column ? (BoardCellState.Selected, BoardCellMode.None, null)
        : Model.OwnShipCells.Any(c => c.Row == row && c.Column == column) ? (BoardCellState.Ship, BoardCellMode.None, null)
        : (BoardCellState.Water, BoardCellMode.None, (string?)null));
    var directions = new[]
    {
        (Value: ShipDirection.Up, Arrow: "↑", Label: "Hacia arriba"),
        (Value: ShipDirection.Down, Arrow: "↓", Label: "Hacia abajo"),
        (Value: ShipDirection.Right, Arrow: "→", Label: "Hacia la derecha"),
        (Value: ShipDirection.Left, Arrow: "←", Label: "Hacia la izquierda")
    };
}

@section Styles
{
    <link rel="stylesheet" href="~/css/Battleship/Battleship.css" asp-append-version="true" />
}

<div class="container mt-4">
    <h2 class="mb-4">Dirección del barco</h2>

    <div class="row g-4">
        <div class="col-12 col-lg-5 order-lg-2">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title mb-3">Elija la dirección</h5>
                    <p class="text-muted">
                        Barco @(Model.ShipNumber + 1) (@sizes[Model.ShipNumber] posiciones) desde la celda
                        <span class="badge bg-warning text-dark">@rowLabels[Model.Row]@(Model.Column + 1)</span>
                    </p>

                    <form asp-controller="Battleship" asp-action="Place" method="post">
                        <div asp-validation-summary="All" class="alert alert-danger py-2 mb-3"></div>
                        <input asp-for="Id" type="hidden" />
                        <input asp-for="Version" type="hidden" />
                        <input asp-for="ShipNumber" type="hidden" />
                        <input asp-for="Row" type="hidden" />
                        <input asp-for="Column" type="hidden" />

                        <label asp-for="Direction" class="form-label">Dirección</label>
                        <div class="row g-2 mb-3">
                            @foreach (var direction in directions)
                            {
                                <div class="col-6">
                                    <label class="bs-direction-option d-block mb-0">
                                        <input type="radio" asp-for="Direction" value="@direction.Value" class="visually-hidden" />
                                        <span class="bs-arrow" aria-hidden="true">@direction.Arrow</span>
                                        <span>@direction.Label</span>
                                    </label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="Direction" class="text-danger d-block mb-3"></span>

                        <div class="d-flex gap-2">
                            <a asp-controller="Battleship" asp-action="SelectCell" asp-route-id="@Model.Id" asp-route-shipNumber="@Model.ShipNumber" class="btn btn-secondary">Volver atrás</a>
                            <button type="submit" class="btn btn-primary">Posicionar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-7 order-lg-1">
            <div class="card h-100">
                <div class="card-body">
                    <partial name="_Board" model="board" />
                    <div class="bs-legend">
                        <span><i class="bs-swatch" style="background:#fff3cd;border:2px solid #dc3545;"></i> Celda inicial</span>
                        <span><i class="bs-swatch is-ship"></i> Barcos ya posicionados</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

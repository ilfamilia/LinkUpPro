@model LinkUpPro.Core.Application.ViewModels.Battleship.NewBattleshipGameViewModel

@{
    ViewData["Title"] = "Iniciar partida";
}

<link rel="stylesheet" href="~/css/Battleship/Index.css" asp-append-version="true" />

<div class="container battleship-page battleship-page--medium mt-4 mb-5">
    <h1 class="h2 mb-2">Iniciar partida de Battleship</h1>
    <p class="text-muted">Selecciona un amigo activo con quien no tengas otra partida sin finalizar.</p>

    <form asp-action="New" method="get" class="row g-2 align-items-end battleship-filter-panel mb-4">
        <div class="col-12 col-md-7">
            <label for="searchText" class="form-label">Buscar por nombre de usuario</label>
            <input id="searchText" name="searchText" value="@Model.SearchText"
                   maxlength="100" class="form-control" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Buscar</button>
        </div>
        <div class="col-auto">
            <a asp-action="New" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>

    <form asp-controller="Battleship" asp-action="Create" method="post" asp-antiforgery="true">
        <input asp-for="SearchText" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <span asp-validation-for="SelectedOpponentUserId" class="text-danger"></span>

        @if (Model.Opponents.Count == 0)
        {
            <div class="battleship-empty-state">
                @(string.IsNullOrWhiteSpace(Model.SearchText)
                    ? "No tiene amigos disponibles para iniciar una partida."
                    : "No se encontraron amigos disponibles con ese nombre de usuario.")
            </div>
        }
        else
        {
            <div class="row g-3 mb-4">
                @foreach (var opponent in Model.Opponents)
                {
                    string imagePath = string.IsNullOrWhiteSpace(opponent.ProfileImage)
                        ? Url.Content("~/Images/Defaults/default-profile.png")
                        : Url.Content($"~/{opponent.ProfileImage}");
                    <div class="col-12 col-md-6">
                        <div class="card battleship-opponent-card h-100">
                            <div class="card-body d-flex gap-3 align-items-center">
                                <input class="form-check-input flex-shrink-0"
                                       type="radio" name="SelectedOpponentUserId"
                                       id="opponent-@opponent.Id" value="@opponent.Id"
                                       checked="@(Model.SelectedOpponentUserId == opponent.Id)" />
                                <label class="d-flex align-items-center gap-3 flex-grow-1"
                                       for="opponent-@opponent.Id">
                                    <img src="@imagePath" alt="Foto de @opponent.UserName"
                                         width="52" height="52" class="rounded-circle object-fit-cover battleship-avatar" />
                                    <span class="fw-semibold">@opponent.UserName</span>
                                </label>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-secondary">Volver atrás</a>
            <button type="submit" class="btn btn-primary"
                    disabled="@(Model.Opponents.Count == 0)">
                Iniciar partida
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

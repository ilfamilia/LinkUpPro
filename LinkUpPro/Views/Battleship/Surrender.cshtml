@model LinkUpPro.Core.Application.ViewModels.Battleship.BattleshipSurrenderViewModel

@{
    ViewData["Title"] = "Confirmar rendición";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-7">
            <div class="card">
                <div class="card-body">
                    <h1 class="h4 mb-3">¿Está seguro que desea rendirse?</h1>
                    <p>Partida #@Model.GameId contra <strong>@Model.OpponentUserName</strong>.</p>
                    <p class="text-muted">
                        Al aceptar, la partida terminará inmediatamente y el otro
                        jugador será declarado ganador. No podrá deshacer esta acción.
                    </p>
                    <form asp-controller="Battleship" asp-action="ConfirmSurrender"
                          method="post" asp-antiforgery="true" class="d-flex gap-2">
                        <input type="hidden" name="gameId" value="@Model.GameId" />
                        <a asp-action="Details" asp-route-gameId="@Model.GameId"
                           class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-danger">Aceptar rendición</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

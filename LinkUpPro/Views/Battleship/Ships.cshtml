@model GameDetailsViewModel
@* Lists only the caller's unplaced ships, including distinct identifiers for both length-three ships. *@
@{
    ViewData["Title"] = "Seleccionar barco";
    var sizes = new[] { 2, 3, 3, 4, 5 };
    var placed = 5 - Model.UnplacedShipNumbers.Count;
}

@section Styles
{
    <link rel="stylesheet" href="~/css/Battleship/Battleship.css" asp-append-version="true" />
}

<div class="container mt-4">
    <h2 class="mb-4">Configuración de barcos</h2>

    <div class="card">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <h5 class="card-title mb-0">Selecciona un barco</h5>
                <span class="text-muted">Partida con <span class="fw-semibold">@Model.Opponent.UserName</span></span>
            </div>

            <div class="mb-3">
                <small class="text-muted">Barcos posicionados: @placed de 5</small>
                <div class="progress" role="progressbar" aria-valuenow="@placed" aria-valuemin="0" aria-valuemax="5" style="height: .5rem;">
                    <div class="progress-bar" style="width: @(placed * 20)%"></div>
                </div>
            </div>

            <form asp-controller="Battleship" asp-action="SelectCell" method="get">
                <input name="id" type="hidden" value="@Model.Id" />

                <ul class="list-group mb-3">
                    @foreach (var ship in Model.UnplacedShipNumbers)
                    {
                        <li class="list-group-item bs-ship-option">
                            <label for="ship-@ship" class="d-flex flex-wrap align-items-center gap-3 mb-0 w-100" style="cursor: pointer;">
                                <input class="form-check-input mt-0" type="radio" name="shipNumber" value="@ship" id="ship-@ship" required />
                                <span class="bs-ship-blocks" aria-hidden="true">
                                    @for (var i = 0; i < sizes[ship]; i++) { <span></span> }
                                </span>
                                <span>Barco @(ship + 1) · @sizes[ship] posiciones</span>
                            </label>
                        </li>
                    }
                </ul>

                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Battleship" asp-action="Index" class="btn btn-secondary">Volver atrás</a>
                    @if (placed > 0)
                    {
                        <a asp-controller="Battleship" asp-action="OwnBoard" asp-route-id="@Model.Id" class="btn btn-outline-primary">Ver mi tablero</a>
                    }
                    <button type="submit" class="btn btn-success">Posicionar barco</button>
                </div>
            </form>
        </div>
    </div>
</div>
